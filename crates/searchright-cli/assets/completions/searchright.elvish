
use builtin;
use str;

set edit:completion:arg-completer[searchright] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'searchright'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'searchright'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand -V 'Print version'
            cand --version 'Print version'
            cand init 'Preview or apply creation of a conservative local CLI configuration'
            cand plan 'Review-plan operations'
            cand source 'Source and provider operations'
            cand strategy 'Search-strategy operations'
            cand run 'Bounded execution-authority operations'
            cand import 'Record import operations'
            cand screen 'Human-governed screening support operations'
            cand report 'Reporting and provenance operations'
            cand completions 'Generate a shell completion script on standard output'
            cand manpage 'Generate the searchright(1) manual page on standard output'
            cand validate-plan 'Validate a review plan and report readiness findings'
            cand validate-strategy 'Validate a source-specific search strategy'
            cand validate-document-evidence 'Validate neutral, non-canonical document extraction evidence'
            cand compile 'Compile a portable strategy into source syntax'
            cand deduplicate 'Deduplicate a JSON/YAML array of bibliographic records'
            cand prisma 'Validate or render a PRISMA flow contract'
            cand verify-audit 'Verify a JSONL hash-chained audit ledger'
            cand import-records 'Import bibliographic records and preserve source provenance'
            cand export-records 'Export canonical records with a conversion receipt'
            cand study-graph 'Validate and summarise a record-report-study graph'
            cand validate-search 'Evaluate PRESS, seed-set recall and translation-loss gates'
            cand living-diff 'Compare parent and current result sets for a living review'
            cand validate-living-lineage 'Validate a set of living-update lineage contracts'
            cand provenance 'Build RO-Crate and W3C PROV-compatible exports'
            cand rank 'Rank records transparently for prioritisation only'
            cand inspect-content 'Inspect untrusted text for instruction-like or active-content markers'
            cand render-diagnostics 'Render stable accessible diagnostics without ANSI-dependent output'
            cand evaluate-governance 'Evaluate a data-handling request against an institutional policy'
            cand authorise-endpoint 'Authorise an HTTPS endpoint against an execution envelope'
            cand validate-amendment 'Validate a protocol amendment'
            cand validate-standard-pack 'Validate a methodological standards pack'
            cand validate-standard-assessment 'Validate an assessment against a standards pack'
            cand validate-ranking-calibration 'Validate ranking calibration and its no-auto-exclusion contract'
            cand validate-discovery-run 'Validate a supplementary-discovery run'
            cand verify-workflow-trace 'Verify an evidence-bearing lifecycle trace against the finite assurance model'
            cand discovery-candidates 'Resolve bounded supplementary-discovery candidates for human release'
            cand verify-provider-component 'Verify a WASI provider-component manifest against exact component bytes'
            cand plan-licensed-request 'Build a redacted bring-your-own-access request plan'
            cand validate-benchmark-report 'Validate a benchmark report and its explicit claim boundary'
            cand providers 'List provider manifests available in the default no-network build'
            cand workflow 'Print the conservative agent workflow policy'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'searchright;init'= {
            cand --target 'target'
            cand --apply 'Apply the write. Without this flag the command is a dry run'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'searchright;plan'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand validate 'Validate a review plan and report readiness findings'
            cand validate-amendment 'Validate a protocol amendment'
            cand evaluate-governance 'Evaluate a data-handling request against institutional policy'
            cand workflow 'Print the conservative agent workflow policy'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'searchright;plan;validate'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'searchright;plan;validate-amendment'= {
            cand -h 'Print help'
