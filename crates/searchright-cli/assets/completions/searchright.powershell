            [CompletionResult]::new('manpage', 'manpage', [CompletionResultType]::ParameterValue, 'Generate the searchright(1) manual page on standard output')
            [CompletionResult]::new('validate-plan', 'validate-plan', [CompletionResultType]::ParameterValue, 'Validate a review plan and report readiness findings')
            [CompletionResult]::new('validate-strategy', 'validate-strategy', [CompletionResultType]::ParameterValue, 'Validate a source-specific search strategy')
            [CompletionResult]::new('validate-document-evidence', 'validate-document-evidence', [CompletionResultType]::ParameterValue, 'Validate neutral, non-canonical document extraction evidence')
            [CompletionResult]::new('compile', 'compile', [CompletionResultType]::ParameterValue, 'Compile a portable strategy into source syntax')
