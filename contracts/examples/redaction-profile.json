{
  "claim_boundary": "The profile minimises common receipt leaks. It is not a proof that arbitrary payloads contain no identifying, licensed or confidential content.",
  "minimum_high_entropy_length": 20,
  "preserve_key_names": true,
  "profile_id": "searchright-default-receipt-redaction",
  "redact_bearer_tokens": true,
  "redact_email_addresses": true,
  "redact_probable_high_entropy_values": true,
  "replacement": "[REDACTED]",
  "safe_query_keys": [
    "db",
    "retmode",
    "format",
    "resulttype",
    "pagesize",
    "rows",
    "retmax",
    "retstart",
    "cursor"
  ],
  "schema_version": "org.searchright.redaction-profile.v1",
  "sensitive_object_keys": [
    "access_token",
    "api_key",
    "apikey",
    "authorization",
    "client_secret",
    "cookie",
    "email",
    "key",
    "mailto",
    "password",
    "proxy-authorization",
    "secret",
    "set-cookie",
    "signature",
    "token",
    "x-api-key"
  ],
  "sensitive_query_keys": [
    "access_token",
    "api_key",
    "apikey",
    "authorization",
    "client_secret",
    "email",
    "key",
    "mailto",
    "password",
    "q",
    "query",
    "search",
    "secret",
    "sig",
    "signature",
    "term",
    "token"
  ]
}
