{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/architecture-policy.v1.schema.json",
  "title": "Searchright architecture fitness policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default_policy",
    "neutral_crates",
    "forbidden_dependency_prefixes_for_neutral_crates",
    "forbidden_internal_edges",
    "network_dependencies",
    "provider_endpoint_source_roots",
    "final_eligibility_authority_source_roots",
    "external_write_scripts",
    "public_package_default",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "org.searchright.architecture-policy.v1"
    },
    "default_policy": {
      "const": "deny"
    },
    "neutral_crates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_dependency_prefixes_for_neutral_crates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "network_dependencies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provider_endpoint_source_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "final_eligibility_authority_source_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "external_write_scripts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "apply_flag",
          "environment_gate"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^scripts/"
          },
          "apply_flag": {
            "type": "string",
            "minLength": 1
          },
          "environment_gate": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "public_package_default": {
      "const": "deny"
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "forbidden_internal_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "reason"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
