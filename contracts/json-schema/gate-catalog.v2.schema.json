{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/gate-catalog.v2.schema.json",
  "title": "Searchright executable gate catalogue v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_from",
    "default_capabilities",
    "gates"
  ],
  "properties": {
    "schema_version": {
      "const": "org.searchright.gate-catalog.v2"
    },
    "generated_from": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "default_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "external_writes",
        "compiler_required"
      ],
      "properties": {
        "network": {
          "const": false
        },
        "external_writes": {
          "const": false
        },
        "compiler_required": {
          "const": false
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/gate"
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "command",
        "command_kind",
        "program",
        "script",
        "category",
        "harness_gate",
        "network",
        "external_writes",
        "compiler_required",
        "evidence_ceiling",
        "covered_assertions",
        "claim_boundary"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "pattern": "^SR-GATE-[A-Z0-9-]+$"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "command_kind": {
          "enum": [
            "repository_script",
            "rust_toolchain",
            "python_module",
            "node_toolchain",
            "external_tool"
          ]
        },
        "program": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "script": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^scripts/"
            },
            {
              "type": "null"
            }
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "harness_gate": {
          "type": "boolean"
        },
        "network": {
          "type": "boolean"
        },
        "external_writes": {
          "const": false
        },
        "compiler_required": {
          "type": "boolean"
        },
        "evidence_ceiling": {
          "enum": [
            "source_verified",
            "source_reproducible",
            "compiler_verified"
          ]
        },
        "covered_assertions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^T[0-9]{2}-A[0-9]{3}$"
          }
        },
        "claim_boundary": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "command_kind": {
                "const": "repository_script"
              }
            },
            "required": [
              "command_kind"
            ]
          },
          "then": {
            "properties": {
              "script": {
                "type": "string",
                "pattern": "^scripts/"
              },
              "compiler_required": {
                "const": false
              },
              "harness_gate": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_kind": {
                "const": "rust_toolchain"
              }
            },
            "required": [
              "command_kind"
            ]
          },
          "then": {
            "properties": {
              "script": {
                "type": "null"
              },
              "compiler_required": {
                "const": true
              },
              "evidence_ceiling": {
                "const": "compiler_verified"
              },
              "harness_gate": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_kind": {
                "enum": [
                  "python_module",
                  "node_toolchain",
                  "external_tool"
                ]
              }
            },
            "required": [
              "command_kind"
            ]
          },
          "then": {
            "properties": {
              "script": {
                "type": "null"
              },
              "harness_gate": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
