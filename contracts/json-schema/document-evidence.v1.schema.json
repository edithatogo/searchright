{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/document-evidence.v1.schema.json",
  "title": "Searchright Document Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "upstream_schema_version",
    "references",
    "citation_callouts",
    "diagnostics",
    "provenance",
    "canonical_write_permitted",
    "retained_full_text"
  ],
  "properties": {
    "schema_version": {
      "const": "org.searchright.document-evidence.v1"
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "upstream_schema_version": {
      "type": "string",
      "minLength": 1
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "citation_callouts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/callout"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "canonical_write_permitted": {
      "const": false
    },
    "retained_full_text": {
      "type": "boolean"
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_byte",
        "end_byte",
        "surface",
        "source_id",
        "page",
        "bounding_box"
      ],
      "properties": {
        "start_byte": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "end_byte": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "bounding_box": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "value",
        "span"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "span": {
          "oneOf": [
            {
              "$ref": "#/$defs/span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "raw_citation",
        "fields",
        "span",
        "confidence",
        "review_required"
      ],
      "properties": {
        "reference_id": {
          "type": "string",
          "minLength": 1
        },
        "raw_citation": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "span": {
          "oneOf": [
            {
              "$ref": "#/$defs/span"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "review_required": {
          "type": "boolean"
        }
      }
    },
    "callout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "callout_id",
        "surface",
        "span",
        "reference_id",
        "confidence",
        "review_required"
      ],
      "properties": {
        "callout_id": {
          "type": "string",
          "minLength": 1
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "reference_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "review_required": {
          "type": "boolean"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message",
        "subject_id"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "backend_version",
        "configuration",
        "input_sha256",
        "endpoint_class",
        "route_trace_digest"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "backend_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuration": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "endpoint_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "route_trace_digest": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
