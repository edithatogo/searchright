{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/search-run.v1.schema.json",
  "title": "Search Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "run_id",
    "purpose",
    "started_at",
    "completed_at",
    "receipts",
    "supersedes_run_id"
  ],
  "properties": {
    "schema_version": {
      "const": "org.searchright.search-run.v1"
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "completed_at": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "receipts": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.searchright.dev/source-receipt.v1.schema.json"
      }
    },
    "supersedes_run_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
