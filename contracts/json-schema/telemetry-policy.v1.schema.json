{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/telemetry-policy.v1.schema.json",
  "title": "Telemetry policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "enabled",
    "endpoint",
    "attribute_allowlist",
    "prohibited_attributes",
    "sampling_per_million",
    "retention_days",
    "approved_by"
  ],
  "properties": {
    "schema_version": {
      "const": "org.searchright.telemetry-policy.v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "endpoint": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "attribute_allowlist": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "prohibited_attributes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sampling_per_million": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "retention_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 365
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  }
}
