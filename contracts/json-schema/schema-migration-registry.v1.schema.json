{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/schema-migration-registry.v1.schema.json",
  "title": "Searchright schema migration registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "automatic_migration",
    "families",
    "default_policy",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "org.searchright.schema-migration-registry.v1"
    },
    "automatic_migration": {
      "const": false
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "versions",
          "migrations",
          "minimum_read_version",
          "current_write_version"
        ],
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "versions": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "schema_id",
                "status"
              ],
              "properties": {
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "schema_id": {
                  "type": "string",
                  "format": "uri"
                },
                "status": {
                  "enum": [
                    "supported_read_only",
                    "current",
                    "deprecated"
                  ]
                }
              }
            }
          },
          "migrations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^contracts/migrations/"
            }
          },
          "minimum_read_version": {
            "type": "integer",
            "minimum": 1
          },
          "current_write_version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "default_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknown_version",
        "destructive_migration",
        "implicit_write_upgrade",
        "backup_required",
        "receipt_required"
      ],
      "properties": {
        "unknown_version": {
          "const": "reject"
        },
        "destructive_migration": {
          "const": "deny"
        },
        "implicit_write_upgrade": {
          "const": "deny"
        },
        "backup_required": {
          "const": true
        },
        "receipt_required": {
          "const": true
        }
      }
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
