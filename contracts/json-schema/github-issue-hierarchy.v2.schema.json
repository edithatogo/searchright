{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/github-issue-hierarchy.v2.schema.json",
  "title": "Searchright generated GitHub issue hierarchy v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "epic_key", "nodes", "generated_at", "apply_permitted", "state_sync_policy", "project_manifest"],
  "properties": {
    "schema_version": {"const": "org.searchright.github-issue-hierarchy.v2"},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "epic_key": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "apply_permitted": {"const": false},
    "state_sync_policy": {"const": "task_issues_only"},
    "project_manifest": {"const": "conductor/github/project.json"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "kind", "parent_key", "body_path", "labels", "status", "desired_state", "track_id", "phase_number", "task_number", "project_fields"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "kind": {"enum": ["epic", "track", "phase", "task"]},
          "parent_key": {"type": ["string", "null"], "minLength": 1},
          "body_path": {"type": "string", "minLength": 1},
          "labels": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "status": {"const": "prepared_not_synced"},
          "desired_state": {"enum": ["open", "closed"]},
          "track_id": {"type": ["string", "null"], "pattern": "^[0-9]{2}$"},
          "phase_number": {"type": ["integer", "null"], "minimum": 1, "maximum": 4},
          "task_number": {"type": ["integer", "null"], "minimum": 1},
          "project_fields": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": ["string", "integer"]}
          }
        }
      }
    }
  }
}
