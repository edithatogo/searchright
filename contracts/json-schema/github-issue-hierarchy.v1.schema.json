{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/github-issue-hierarchy.v1.schema.json",
  "title": "Searchright generated GitHub issue hierarchy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "epic_key", "nodes", "generated_at", "apply_permitted"],
  "properties": {
    "schema_version": {"const": "org.searchright.github-issue-hierarchy.v1"},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "epic_key": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "apply_permitted": {"const": false},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "kind", "parent_key", "body_path", "labels", "status"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "kind": {"enum": ["epic", "track", "phase"]},
          "parent_key": {"type": ["string", "null"], "minLength": 1},
          "body_path": {"type": "string", "minLength": 1},
          "labels": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "status": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
