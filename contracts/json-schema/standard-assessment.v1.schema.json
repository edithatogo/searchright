{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/standard-assessment.v1.schema.json",
  "title": "Searchright Standard Assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "pack_id",
    "pack_version",
    "assessed_at",
    "assessed_by",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "org.searchright.standard-assessment.v1"
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "pack_version": {
      "type": "string",
      "minLength": 1
    },
    "assessed_at": {
      "type": "string",
      "minLength": 1
    },
    "assessed_by": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "state",
          "evidence",
          "note"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "met",
              "partial",
              "unmet",
              "not_applicable",
              "not_assessed"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    }
  }
}
