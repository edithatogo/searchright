{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/research-object-handoff-plan.v1.schema.json",
  "title": "Research Object Handoff Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "review_id", "execution_mode", "input_artifacts",
    "proposed_destinations", "deposit_authorized", "ro_crate_conformance_claimed",
    "osf_acceptance_claimed", "delegated_export_track", "prerequisites", "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "org.searchright.research-object-handoff-plan.v1"},
    "plan_id": {"type": "string", "minLength": 1},
    "review_id": {"type": "string", "minLength": 1},
    "execution_mode": {"const": "dry_run"},
    "input_artifacts": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "kind", "sha256"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["srpack", "audit_export", "source_receipts"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "proposed_destinations": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "target_reference", "external_write"],
        "properties": {
          "kind": {"enum": ["ro_crate", "osf"]},
          "target_reference": {"type": "string", "minLength": 1},
          "external_write": {"const": true}
        }
      }
    },
    "deposit_authorized": {"const": false},
    "ro_crate_conformance_claimed": {"const": false},
    "osf_acceptance_claimed": {"const": false},
    "delegated_export_track": {"const": "25"},
    "prerequisites": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
