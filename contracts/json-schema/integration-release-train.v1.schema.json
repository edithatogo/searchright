{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/integration-release-train.v1.schema.json",
  "title": "Searchright cross-repository release train",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_train_id",
    "generated_at",
    "automatic_promotion",
    "components",
    "stages",
    "rollback",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "org.searchright.integration-release-train.v1"
    },
    "release_train_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "automatic_promotion": {
      "const": false
    },
    "components": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "role",
          "passport",
          "consumer_contract",
          "promotion_order"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[^/\\s]+/[^/\\s]+$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "passport": {
            "type": [
              "string",
              "null"
            ]
          },
          "consumer_contract": {
            "type": [
              "string",
              "null"
            ]
          },
          "promotion_order": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "required_evidence",
          "automatic"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "required_evidence": {
            "type": "string",
            "minLength": 1
          },
          "automatic": {
            "const": false
          }
        }
      }
    },
    "rollback": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
