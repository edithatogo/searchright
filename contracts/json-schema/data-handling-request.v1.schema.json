{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/data-handling-request.v1.schema.json",
  "title": "Data Handling Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "review_id",
    "classification",
    "operation",
    "deployment_mode",
    "region",
    "retention_days",
    "cross_border_transfer",
    "dry_run"
  ],
  "properties": {
    "schema_version": {
      "const": "org.searchright.data-handling-request.v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "enum": [
        "public_metadata",
        "internal_review_data",
        "confidential",
        "restricted_full_text",
        "sensitive_personal_data"
      ]
    },
    "operation": {
      "enum": [
        "metadata",
        "full_text_analysis",
        "full_text_persistence",
        "export",
        "telemetry",
        "external_model_processing"
      ]
    },
    "deployment_mode": {
      "enum": [
        "local_only",
        "institution_self_hosted",
        "hosted_single_tenant",
        "hosted_multi_tenant"
      ]
    },
    "region": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "retention_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "cross_border_transfer": {
      "type": "boolean"
    },
    "dry_run": {
      "type": "boolean"
    }
  }
}
