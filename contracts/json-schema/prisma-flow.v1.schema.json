{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/prisma-flow.v1.schema.json",
  "title": "Searchright PRISMA Flow v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "records_databases",
    "records_registers",
    "records_other",
    "duplicates_removed",
    "automation_removed",
    "other_removed",
    "records_screened",
    "records_excluded",
    "reports_sought",
    "reports_not_retrieved",
    "reports_assessed",
    "full_text_exclusions",
    "studies_included",
    "reports_included"
  ],
  "properties": {
    "schema_version": {
      "const": "org.searchright.prisma-flow.v1"
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "records_databases": {
      "type": "integer",
      "minimum": 0
    },
    "records_registers": {
      "type": "integer",
      "minimum": 0
    },
    "records_other": {
      "type": "integer",
      "minimum": 0
    },
    "duplicates_removed": {
      "type": "integer",
      "minimum": 0
    },
    "automation_removed": {
      "type": "integer",
      "minimum": 0
    },
    "other_removed": {
      "type": "integer",
      "minimum": 0
    },
    "records_screened": {
      "type": "integer",
      "minimum": 0
    },
    "records_excluded": {
      "type": "integer",
      "minimum": 0
    },
    "reports_sought": {
      "type": "integer",
      "minimum": 0
    },
    "reports_not_retrieved": {
      "type": "integer",
      "minimum": 0
    },
    "reports_assessed": {
      "type": "integer",
      "minimum": 0
    },
    "studies_included": {
      "type": "integer",
      "minimum": 0
    },
    "reports_included": {
      "type": "integer",
      "minimum": 0
    },
    "full_text_exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason_id",
          "label",
          "count"
        ],
        "properties": {
          "reason_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
