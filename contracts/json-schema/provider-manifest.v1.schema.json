{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/provider-manifest.v1.schema.json",
  "title": "Searchright Provider Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider_id",
    "display_name",
    "version",
    "support_level",
    "capabilities",
    "allowed_hosts",
    "authentication_required",
    "licensed",
    "default_min_interval_ms",
    "policy_notes"
  ],
  "properties": {
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "support_level": {
      "enum": [
        "planned",
        "fixture_backed",
        "opt_in_live",
        "maintained"
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "search",
          "pagination",
          "import",
          "lookup",
          "backward_citation",
          "forward_citation",
          "updates"
        ]
      }
    },
    "allowed_hosts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?:\\.(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?))*$"
      }
    },
    "authentication_required": {
      "type": "boolean"
    },
    "licensed": {
      "type": "boolean"
    },
    "default_min_interval_ms": {
      "type": "integer",
      "minimum": 0
    },
    "policy_notes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
