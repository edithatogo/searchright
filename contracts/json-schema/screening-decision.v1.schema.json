{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/screening-decision.v1.schema.json",
  "title": "Searchright Screening Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "review_id",
    "subject_id",
    "round",
    "reviewer_id",
    "reviewer_kind",
    "decision",
    "exclusion_reason",
    "confidence",
    "decided_at",
    "rationale",
    "eligibility_version",
    "agent_provenance"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "round": {
      "enum": [
        "title_abstract",
        "full_text"
      ]
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_kind": {
      "enum": [
        "human",
        "agent",
        "adjudicator"
      ]
    },
    "decision": {
      "enum": [
        "include",
        "exclude",
        "unclear"
      ]
    },
    "exclusion_reason": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason_id",
            "criterion_id",
            "label",
            "evidence"
          ],
          "properties": {
            "reason_id": {
              "type": "string",
              "minLength": 1
            },
            "criterion_id": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            }
          }
        }
      ]
    },
    "confidence": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ]
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "eligibility_version": {
      "type": "string",
      "minLength": 1
    },
    "agent_provenance": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "exclude"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "exclusion_reason": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "exclusion_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reviewer_kind": {
            "const": "agent"
          }
        },
        "required": [
          "reviewer_kind"
        ]
      },
      "then": {
        "properties": {
          "agent_provenance": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
