{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/audit-event-registry.v1.schema.json",
  "title": "Audit Event Schema Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "envelope_schema_version", "unknown_event_type_policy",
    "unknown_payload_version_policy", "maximum_payload_bytes", "prohibited_payload_keys",
    "event_types", "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "org.searchright.audit-event-registry.v1"},
    "envelope_schema_version": {"const": "org.searchright.audit-event.v1"},
    "unknown_event_type_policy": {"const": "reject"},
    "unknown_payload_version_policy": {"const": "reject"},
    "maximum_payload_bytes": {"type": "integer", "minimum": 1},
    "prohibited_payload_keys": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "event_types": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["event_type", "current_payload_version", "legacy_unversioned_payload_version", "allowed_payload_keys", "versions", "migrations"],
        "properties": {
          "event_type": {"type": "string", "minLength": 1},
          "current_payload_version": {"type": "integer", "minimum": 1},
          "legacy_unversioned_payload_version": {"type": "integer", "minimum": 1},
          "allowed_payload_keys": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "versions": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["version", "status"],
              "properties": {
                "version": {"type": "integer", "minimum": 0},
                "status": {"enum": ["migration_only", "current"]}
              }
            }
          },
          "migrations": {
            "type": "array",
            "items": {"type": "string", "pattern": "^contracts/events/migrations/"}
          }
        }
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
