{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/bibliographic-record.v1.schema.json",
  "title": "Bibliographic Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "source_receipt_id",
    "native_id",
    "kind",
    "identifiers",
    "title",
    "abstract_text",
    "authors",
    "container_title",
    "publication_year",
    "publication_date",
    "languages",
    "subjects",
    "urls",
    "provider_metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "org.searchright.bibliographic-record.v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "source_receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "native_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "oneOf": [
        {
          "enum": [
            "journal_article",
            "preprint",
            "conference",
            "trial_registry",
            "thesis",
            "report",
            "dataset"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "other"
          ],
          "properties": {
            "other": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "doi": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "pmid": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "pmcid": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "trial_registration": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "openalex": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "isbn": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "other": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "default": {}
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "abstract_text": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "container_title": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "publication_year": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": -10000,
          "maximum": 30000
        },
        {
          "type": "null"
        }
      ]
    },
    "publication_date": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "urls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "provider_metadata": {}
  }
}
