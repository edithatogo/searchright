{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/living-update.v1.schema.json",
  "title": "Searchright Living Update v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "run_id",
    "parent_run_id",
    "status",
    "started_at",
    "completed_at",
    "protocol_version",
    "cursors_before",
    "cursors_after",
    "changes",
    "requires_human_release",
    "supersedes_run_id"
  ],
  "properties": {
    "schema_version": {
      "const": "org.searchright.living-update.v1"
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_run_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "cursors_before": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_id",
          "cursor_kind",
          "value",
          "retrieved_through"
        ],
        "properties": {
          "provider_id": {
            "type": "string",
            "minLength": 1
          },
          "cursor_kind": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_through": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    },
    "cursors_after": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_id",
          "cursor_kind",
          "value",
          "retrieved_through"
        ],
        "properties": {
          "provider_id": {
            "type": "string",
            "minLength": 1
          },
          "cursor_kind": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_through": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "kind",
          "before_digest",
          "after_digest",
          "note"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "added",
              "updated",
              "missing_from_source",
              "merged",
              "restored"
            ]
          },
          "before_digest": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "after_digest": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requires_human_release": {
      "type": "boolean"
    },
    "supersedes_run_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  }
}
