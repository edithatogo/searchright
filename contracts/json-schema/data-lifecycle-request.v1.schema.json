{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/data-lifecycle-request.v1.schema.json",
  "title": "Data Lifecycle Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "review_id", "classification", "action",
    "execution_mode", "target_ids", "retention_days", "export_destination",
    "includes_audit_log", "legal_hold", "approval"
  ],
  "properties": {
    "schema_version": {"const": "org.searchright.data-lifecycle-request.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "review_id": {"type": "string", "minLength": 1},
    "classification": {
      "enum": ["public_metadata", "internal_review_data", "confidential", "restricted_full_text", "sensitive_personal_data"]
    },
    "action": {"enum": ["retain", "export", "delete"]},
    "execution_mode": {"enum": ["preview", "apply"]},
    "target_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "retention_days": {
      "oneOf": [{"type": "integer", "minimum": 1, "maximum": 4294967295}, {"type": "null"}]
    },
    "export_destination": {
      "oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
    },
    "includes_audit_log": {"type": "boolean"},
    "legal_hold": {"type": "boolean"},
    "approval": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["approval_id", "approved_by", "review_id", "action", "request_digest", "policy_id", "nonce", "approved_at", "expires_at"],
          "properties": {
            "approval_id": {"type": "string", "minLength": 1},
            "approved_by": {"type": "string", "minLength": 1},
            "review_id": {"type": "string", "minLength": 1},
            "action": {"enum": ["retain", "export", "delete"]},
            "request_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "policy_id": {"type": "string", "minLength": 1},
            "nonce": {"type": "string", "minLength": 1},
            "approved_at": {"type": "string", "format": "date-time"},
            "expires_at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "retain"}}},
      "then": {"properties": {"retention_days": {"type": "integer", "minimum": 1}, "export_destination": {"type": "null"}}}
    },
    {
      "if": {"properties": {"action": {"const": "export"}}},
      "then": {"properties": {"retention_days": {"type": "null"}, "export_destination": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"action": {"const": "delete"}}},
      "then": {"properties": {"retention_days": {"type": "null"}, "export_destination": {"type": "null"}}}
    },
    {
      "if": {"properties": {"execution_mode": {"const": "preview"}}},
      "then": {"properties": {"approval": {"type": "null"}}}
    }
  ]
}
