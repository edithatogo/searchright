{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/integration-passport.v1.schema.json",
  "title": "Searchright integration passport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "integration_id",
    "repository",
    "revision",
    "default_branch",
    "canonical_upstream",
    "local_fork_role",
    "code_license",
    "content_license",
    "model_license",
    "redistribution",
    "licence_review_status",
    "drift_policy",
    "mode",
    "dependency_direction",
    "feature_flag",
    "inputs",
    "outputs",
    "default_network",
    "default_external_writes",
    "default_telemetry",
    "automatic_revision_updates",
    "allowed_capabilities",
    "verification",
    "rollback",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "org.searchright.integration-passport.v1"
    },
    "integration_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "default_branch": {
      "type": "string",
      "minLength": 1
    },
    "canonical_upstream": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "revision",
            "default_branch",
            "verification_status"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[^/\\s]+/[^/\\s]+$"
            },
            "revision": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{40}$"
            },
            "default_branch": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "verification_status": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "local_fork_role": {
      "enum": [
        "original",
        "mirror",
        "patch_carrier",
        "derived_product"
      ]
    },
    "code_license": {
      "type": "string",
      "minLength": 1
    },
    "content_license": {
      "type": "string",
      "minLength": 1
    },
    "model_license": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "redistribution": {
      "type": "string",
      "minLength": 1
    },
    "licence_review_status": {
      "enum": [
        "cleared",
        "reference_only",
        "review_required",
        "upstream_licence_inherited"
      ]
    },
    "drift_policy": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "rust_dependency",
        "cli_json",
        "mcp",
        "wasi_component",
        "dataset_fixture",
        "documentation_pack",
        "policy_inheritance",
        "generated_adapter"
      ]
    },
    "dependency_direction": {
      "enum": [
        "searchright_consumes_upstream",
        "downstream_consumes_searchright",
        "bidirectional_via_neutral_contract",
        "no_runtime_dependency"
      ]
    },
    "feature_flag": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "inputs": {
      "$ref": "#/$defs/contracts"
    },
    "outputs": {
      "$ref": "#/$defs/contracts"
    },
    "default_network": {
      "const": false
    },
    "default_external_writes": {
      "const": false
    },
    "default_telemetry": {
      "const": false
    },
    "automatic_revision_updates": {
      "const": false
    },
    "allowed_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command",
          "evidence_level",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "evidence_level": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "rollback": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    }
  },
  "anyOf": [
    {
      "properties": {
        "inputs": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "outputs": {
          "minItems": 1
        }
      }
    }
  ],
  "$defs": {
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "path",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "local_fork_role": {
            "const": "original"
          }
        }
      },
      "then": {
        "properties": {
          "canonical_upstream": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "local_fork_role": {
            "enum": [
              "mirror",
              "patch_carrier",
              "derived_product"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "canonical_upstream": {
            "type": "object"
          }
        }
      }
    }
  ]
}
