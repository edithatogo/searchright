{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/sourceright-parity-matrix.v2.schema.json",
  "title": "Sourceright Parity matrix V2",
  "description": "Declared evidence only. Cross-document coverage, context-bound digests and resource limits require the bounded Rust validator; no cutover authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_kind",
    "legacy",
    "shared",
    "cells"
  ],
  "properties": {
    "schema_version": {
      "const": "org.searchright.sourceright-parity-matrix.v2"
    },
    "evidence_kind": {
      "enum": [
        "synthetic",
        "declared_execution"
      ]
    },
    "legacy": {
      "$ref": "#/$defs/binding",
      "properties": {
        "side": {
          "const": "legacy"
        }
      }
    },
    "shared": {
      "$ref": "#/$defs/binding",
      "properties": {
        "side": {
          "const": "shared"
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/observed"
      }
    }
  },
  "$defs": {
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "fixture_sha256",
        "case_id",
        "dimension"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f]*\\S)?$"
        },
        "fixture_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "case_id": {
          "enum": [
            "disabled-live",
            "fixture-identifiers",
            "bounded-retry",
            "cache-write-replay",
            "malformed-payload",
            "undeclared-host",
            "secret-redaction"
          ]
        },
        "dimension": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f]*\\S)?$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "case_id": {
                "const": "disabled-live"
              }
            }
          },
          "then": {
            "properties": {
              "dimension": {
                "enum": [
                  "execution mode",
                  "error classification",
                  "endpoint and secret redaction",
                  "disabled-live negative behaviour"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "case_id": {
                "const": "fixture-identifiers"
              }
            }
          },
          "then": {
            "properties": {
              "dimension": {
                "enum": [
                  "provider identity",
                  "identifiers",
                  "normalised fields",
                  "fixture determinism"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "case_id": {
                "const": "bounded-retry"
              }
            }
          },
          "then": {
            "properties": {
              "dimension": {
                "enum": [
                  "retry and rate behaviour",
                  "timeout behaviour",
                  "error classification"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "case_id": {
                "const": "cache-write-replay"
              }
            }
          },
          "then": {
            "properties": {
              "dimension": {
                "enum": [
                  "execution mode",
                  "replay and cache behaviour",
                  "receipt counts"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "case_id": {
                "const": "malformed-payload"
              }
            }
          },
          "then": {
            "properties": {
              "dimension": {
                "enum": [
                  "error classification",
                  "malformed and adversarial response handling"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "case_id": {
                "const": "undeclared-host"
              }
            }
          },
          "then": {
            "properties": {
              "dimension": {
                "enum": [
                  "host policy",
                  "malformed and adversarial response handling"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "case_id": {
                "const": "secret-redaction"
              }
            }
          },
          "then": {
            "properties": {
              "dimension": {
                "enum": [
                  "endpoint and secret redaction",
                  "cache key redaction"
                ]
              }
            }
          }
        }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side",
        "repository",
        "revision",
        "config_sha256",
        "harness_sha256"
      ],
      "properties": {
        "side": {
          "enum": [
            "legacy",
            "shared"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f]*\\S)?$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "harness_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "rights_basis"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f]*\\S)?$"
        },
        "rights_basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f]*\\S)?$"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "provenance",
        "comparator_id"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "comparator_id": {
          "const": "canonical-json-blake3.v1"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "execution_id",
        "evidence_sha256",
        "digest"
      ],
      "properties": {
        "status": {
          "enum": [
            "success",
            "provider_error",
            "harness_failure",
            "skipped"
          ]
        },
        "value": {},
        "execution_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f]*\\S)?$"
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected",
        "legacy",
        "shared",
        "decision_references"
      ],
      "properties": {
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "legacy": {
          "$ref": "#/$defs/observation"
        },
        "shared": {
          "$ref": "#/$defs/observation"
        },
        "decision_references": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f]*\\S)?$"
          }
        }
      }
    }
  }
}
