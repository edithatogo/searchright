{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/standard-pack.v1.schema.json",
  "title": "Searchright Standard Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "family",
    "version",
    "source",
    "provenance_note",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "org.searchright.standard-pack.v1"
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "oneOf": [
        {
          "enum": [
            "prisma2020",
            "prisma_s",
            "prisma_sc_r",
            "prisma_lsr",
            "prisma_p",
            "press2015",
            "cochrane_handbook",
            "mecir",
            "jbi",
            "campbell"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "custom"
          ],
          "properties": {
            "custom": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "provenance_note": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "label",
          "requirement_summary",
          "scope",
          "crosswalks"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "requirement_summary": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "crosswalks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      },
      "minItems": 1
    }
  }
}
