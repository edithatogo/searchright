{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.searchright.dev/redaction-profile.v1.schema.json",
  "title": "Searchright receipt redaction profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "replacement",
    "sensitive_query_keys",
    "sensitive_object_keys",
    "safe_query_keys",
    "redact_email_addresses",
    "redact_bearer_tokens",
    "redact_probable_high_entropy_values",
    "minimum_high_entropy_length",
    "preserve_key_names",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "org.searchright.redaction-profile.v1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "replacement": {
      "const": "[REDACTED]"
    },
    "sensitive_query_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sensitive_object_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "safe_query_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "redact_email_addresses": {
      "const": true
    },
    "redact_bearer_tokens": {
      "const": true
    },
    "redact_probable_high_entropy_values": {
      "const": true
    },
    "minimum_high_entropy_length": {
      "type": "integer",
      "minimum": 16
    },
    "preserve_key_names": {
      "const": true
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
