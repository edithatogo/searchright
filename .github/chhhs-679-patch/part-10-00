+//! Validated JSON persistence with same-directory replacement.
+
+use std::{fs, io::Write, path::Path};
+
+use crate::model::{ModelError, MonitorState};
+
+/// Load monitor state when the file exists.
+pub fn load_state(path: &Path) -> Result<Option<MonitorState>, StorageError> {
+    if !path.exists() {
+        return Ok(None);
+    }
+    let state: MonitorState = serde_json::from_slice(&fs::read(path)?)?;
+    state.validate()?;
+    Ok(Some(state))
+}
+
+/// Validate and replace monitor state using a temporary file in the same directory.
+pub fn save_state(path: &Path, state: &MonitorState) -> Result<(), StorageError> {
+    state.validate()?;
+    let parent = path.parent().unwrap_or_else(|| Path::new("."));
+    fs::create_dir_all(parent)?;
+    let file_name = path
+        .file_name()
+        .and_then(|name| name.to_str())
+        .unwrap_or("state.json");
+    let temporary = parent.join(format!(".{file_name}.{}.tmp", std::process::id()));
+    let bytes = serde_json::to_vec_pretty(state)?;
+    let mut file = fs::File::create(&temporary)?;
+    file.write_all(&bytes)?;
+    file.write_all(b"\n")?;
+    file.sync_all()?;
+    match fs::rename(&temporary, path) {
+        Ok(()) => {}
+        Err(_) if path.exists() => {
+            fs::remove_file(path)?;
+            fs::rename(&temporary, path)?;
+        }
+        Err(error) => return Err(error.into()),
+    }
+    Ok(())
+}
+
+/// State persistence error.
+#[derive(Debug, thiserror::Error)]
+pub enum StorageError {
+    /// File operation failed.
+    #[error(transparent)]
+    Io(#[from] std::io::Error),
+    /// JSON encoding or decoding failed.
+    #[error(transparent)]
+    Json(#[from] serde_json::Error),
+    /// State contract failed validation.
+    #[error(transparent)]
+    Model(#[from] ModelError),
+}
+
+#[cfg(test)]
+mod tests {
+    use std::{
+        collections::BTreeSet,
+        fs,
+        sync::atomic::{AtomicU64, Ordering},
+    };
+
+    use super::*;
+    use crate::model::MONITOR_STATE_SCHEMA_VERSION;
+
+    fn empty_state() -> MonitorState {
+        MonitorState {
+            schema_version: MONITOR_STATE_SCHEMA_VERSION.to_owned(),
+            profile_id: "chhhs".to_owned(),
+            profile_version: "1".to_owned(),
+            taxonomy_version: "1".to_owned(),
+            source_records: Vec::new(),
+            papers: Vec::new(),
+            runs: Vec::new(),
+        }
+    }
+
+    fn temporary_path(label: &str) -> std::path::PathBuf {
+        static NEXT: AtomicU64 = AtomicU64::new(0);
+        let unique = format!(
+            "searchright-chhhs-{label}-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        );
+        std::env::temp_dir().join(unique).join("state.json")
+    }
+
+    #[test]
+    fn state_round_trip_validates_before_and_after_write() {
+        let path = temporary_path("round-trip");
+        let state = empty_state();
+        save_state(&path, &state).unwrap_or_else(|error| panic!("save should pass: {error}"));
+        let loaded = load_state(&path)
+            .unwrap_or_else(|error| panic!("load should pass: {error}"))
+            .unwrap_or_else(|| panic!("state should exist"));
+        assert_eq!(loaded, state);
+        let parent = path.parent().unwrap_or_else(|| Path::new("."));
+        fs::remove_dir_all(parent)
+            .unwrap_or_else(|error| panic!("temporary directory should be removable: {error}"));
+    }
+
+    #[test]
+    fn absent_state_is_not_an_error() {
+        let path = temporary_path("absent");
+        assert!(
+            load_state(&path)
+                .unwrap_or_else(|error| panic!("absent load should pass: {error}"))
+                .is_none()
+        );
+    }
+
+    #[test]
+    fn temporary_paths_are_distinct_for_named_tests() {
+        let paths = [temporary_path("a"), temporary_path("b")]
+            .into_iter()
+            .collect::<BTreeSet<_>>();
+        assert_eq!(paths.len(), 2);
+    }
+}
