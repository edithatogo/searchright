+fn broad_query(aliases: &[&str]) -> String {
+    aliases
+        .iter()
+        .map(|alias| format!("\"{}\"", escape_query(alias)))
+        .collect::<Vec<_>>()
+        .join(" OR ")
+}
+
+fn affiliation_query(aliases: &[&str], suffix: &str, prefix: &str) -> String {
+    aliases
+        .iter()
+        .map(|alias| format!("{prefix}\"{}\"{suffix}", escape_query(alias)))
+        .collect::<Vec<_>>()
+        .join(" OR ")
