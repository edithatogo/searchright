+    Json(#[from] serde_json::Error),
+    /// Searchright provider execution failed.
+    #[error(transparent)]
+    Provider(#[from] ProviderError),
+    /// A named fixture source was absent.
+    #[error("fixture page for provider `{0}` is missing")]
