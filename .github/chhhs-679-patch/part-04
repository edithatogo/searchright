+//! Transparent multi-label thematic and study-design classification.
+
+use std::collections::BTreeSet;
+
+use searchright::contracts::BibliographicRecord;
+
+use crate::model::{
+    CLASSIFICATION_SCHEMA_VERSION, CategoryRule, CategoryScore, PaperClassification,
+    ResearchTaxonomy, normalise_text,
+};
+
+/// Classify one merged bibliographic record using a versioned ruleset.
+#[must_use]
+pub fn classify_record(
+    taxonomy: &ResearchTaxonomy,
+    record: &BibliographicRecord,
+) -> PaperClassification {
+    let title = normalise_text(&record.title);
+    let abstract_text = record
+        .abstract_text
+        .as_deref()
+        .map_or_else(String::new, normalise_text);
+    let subjects = normalise_text(&record.subjects.join(" "));
+
+    let mut themes = taxonomy
+        .themes
+        .iter()
+        .filter_map(|rule| score_rule(rule, &title, &abstract_text, &subjects))
+        .collect::<Vec<_>>();
+    themes.sort_by(category_order);
+
+    let mut study_types = taxonomy
+        .study_types
+        .iter()
+        .filter_map(|rule| score_rule(rule, &title, &abstract_text, &subjects))
+        .collect::<Vec<_>>();
+    study_types.sort_by(category_order);
+    let fallback = taxonomy
+        .study_types
+        .iter()
+        .find(|rule| rule.category_id == taxonomy.fallback_study_type_id)
+        .map_or_else(
+            || CategoryScore {
+                category_id: taxonomy.fallback_study_type_id.clone(),
+                label: "Other or unclear".to_owned(),
+                score: 0,
+                evidence_terms: Vec::new(),
+            },
+            |rule| CategoryScore {
+                category_id: rule.category_id.clone(),
+                label: rule.label.clone(),
+                score: 0,
+                evidence_terms: Vec::new(),
+            },
+        );
+    let specific = study_types
+        .into_iter()
+        .find(|score| score.category_id != taxonomy.fallback_study_type_id);
+    let study_type_uncertain = specific.is_none();
+
+    PaperClassification {
+        schema_version: CLASSIFICATION_SCHEMA_VERSION.to_owned(),
+        taxonomy_version: taxonomy.version.clone(),
+        themes,
+        study_type: specific.unwrap_or(fallback),
+        study_type_uncertain,
+    }
+}
+
+fn category_order(left: &CategoryScore, right: &CategoryScore) -> std::cmp::Ordering {
+    right
+        .score
+        .cmp(&left.score)
+        .then_with(|| left.label.cmp(&right.label))
+}
+
+fn score_rule(
+    rule: &CategoryRule,
+    title: &str,
+    abstract_text: &str,
+    subjects: &str,
+) -> Option<CategoryScore> {
+    let mut score = 0_u32;
+    let mut evidence = BTreeSet::new();
+    for term in &rule.terms {
+        let term = normalise_text(term);
+        let title_match = contains_term(title, &term);
+        let subject_match = contains_term(subjects, &term);
+        let abstract_match = contains_term(abstract_text, &term);
+        if title_match || subject_match || abstract_match {
+            evidence.insert(term);
+            score = score
+                .saturating_add(u32::from(title_match) * 3)
+                .saturating_add(u32::from(subject_match) * 2)
+                .saturating_add(u32::from(abstract_match));
+        }
+    }
+    (score > 0).then(|| CategoryScore {
+        category_id: rule.category_id.clone(),
+        label: rule.label.clone(),
+        score,
+        evidence_terms: evidence.into_iter().collect(),
+    })
+}
+
+fn contains_term(text: &str, term: &str) -> bool {
+    if text.is_empty() || term.is_empty() {
+        return false;
+    }
+    format!(" {text} ").contains(&format!(" {term} "))
+}
+
+#[cfg(test)]
+mod tests {
+    use searchright::contracts::{
+        BIBLIOGRAPHIC_RECORD_SCHEMA_VERSION, RecordIdentifiers, RecordKind,
+    };
+
+    use super::*;
+
+    fn taxonomy() -> ResearchTaxonomy {
+        ResearchTaxonomy {
+            schema_version: crate::model::TAXONOMY_SCHEMA_VERSION.to_owned(),
+            version: "test".to_owned(),
+            themes: vec![
+                CategoryRule {
+                    category_id: "toxinology".to_owned(),
+                    label: "Toxinology".to_owned(),
+                    terms: vec!["snakebite".to_owned(), "antivenom".to_owned()],
+                },
+                CategoryRule {
+                    category_id: "emergency".to_owned(),
+                    label: "Emergency care".to_owned(),
+                    terms: vec!["emergency department".to_owned()],
+                },
+            ],
+            study_types: vec![
+                CategoryRule {
+                    category_id: "cohort".to_owned(),
+                    label: "Cohort study".to_owned(),
+                    terms: vec!["cohort".to_owned()],
+                },
+                CategoryRule {
+                    category_id: "other".to_owned(),
+                    label: "Other or unclear".to_owned(),
+                    terms: vec!["unclear".to_owned()],
+                },
+            ],
+            fallback_study_type_id: "other".to_owned(),
+        }
+    }
+
+    fn record(title: &str, abstract_text: &str) -> BibliographicRecord {
+        BibliographicRecord {
+            schema_version: BIBLIOGRAPHIC_RECORD_SCHEMA_VERSION.to_owned(),
+            record_id: "record".to_owned(),
+            source_receipt_id: "receipt".to_owned(),
+            native_id: "native".to_owned(),
+            kind: RecordKind::JournalArticle,
+            identifiers: RecordIdentifiers::default(),
+            title: title.to_owned(),
+            abstract_text: Some(abstract_text.to_owned()),
+            authors: Vec::new(),
+            container_title: None,
+            publication_year: Some(2026),
+            publication_date: None,
+            languages: Vec::new(),
+            subjects: vec!["Emergency department".to_owned()],
+            urls: Vec::new(),
+            provider_metadata: serde_json::json!({}),
+        }
+    }
+
+    #[test]
+    fn emits_ranked_multi_label_themes_and_study_type() {
+        let result = classify_record(
+            &taxonomy(),
+            &record(
+                "Snakebite cohort in an emergency department",
+                "Antivenom outcomes were assessed.",
+            ),
+        );
+        assert_eq!(result.themes.len(), 2);
+        assert!(result.themes.iter().any(|theme| theme.category_id == "toxinology"));
+        assert!(result.themes.iter().any(|theme| theme.category_id == "emergency"));
+        assert_eq!(result.study_type.category_id, "cohort");
+        assert!(!result.study_type_uncertain);
+    }
+
+    #[test]
+    fn falls_back_when_study_design_is_unclear() {
+        let result = classify_record(&taxonomy(), &record("Snakebite services", "Description"));
+        assert_eq!(result.study_type.category_id, "other");
+        assert!(result.study_type_uncertain);
+    }
+}
