+//! Searchright institutional-publication intelligence demonstration for CHHHS.
+//!
+//! The crate provides a conservative, auditable vertical slice: free-provider
+//! discovery, source receipts, cross-source deduplication, explainable
+//! attribution and NLP classification, living-update lineage, and monthly
+//! report rendering. Network execution is disabled unless the `live` feature
+//! and an explicit operator flag are both present.
+
+#![forbid(unsafe_code)]
+
+pub mod attribution;
+pub mod classification;
+pub mod model;
+pub mod pipeline;
+pub mod report;
+pub mod search;
+pub mod storage;
+
+use std::{fs, path::Path};
+
+use model::{InstitutionProfile, ResearchTaxonomy};
+
+/// Load and validate the checked-in demonstration institution profile.
+pub fn embedded_profile() -> Result<InstitutionProfile, ConfigError> {
+    parse_profile(include_str!(
+        "../resources/chhhs-institution-profile.json"
+    ))
+}
+
+/// Load and validate the checked-in transparent research taxonomy.
+pub fn embedded_taxonomy() -> Result<ResearchTaxonomy, ConfigError> {
+    parse_taxonomy(include_str!("../resources/research-taxonomy.json"))
+}
+
+/// Load a profile override, or the checked-in profile when no path is supplied.
+pub fn load_profile(path: Option<&Path>) -> Result<InstitutionProfile, ConfigError> {
+    match path {
+        Some(path) => parse_profile(&fs::read_to_string(path)?),
+        None => embedded_profile(),
+    }
+}
+
+/// Load a taxonomy override, or the checked-in taxonomy when no path is supplied.
+pub fn load_taxonomy(path: Option<&Path>) -> Result<ResearchTaxonomy, ConfigError> {
+    match path {
+        Some(path) => parse_taxonomy(&fs::read_to_string(path)?),
+        None => embedded_taxonomy(),
+    }
+}
+
+fn parse_profile(text: &str) -> Result<InstitutionProfile, ConfigError> {
+    let value: InstitutionProfile = serde_json::from_str(text)?;
+    value.validate()?;
+    Ok(value)
+}
+
+fn parse_taxonomy(text: &str) -> Result<ResearchTaxonomy, ConfigError> {
+    let value: ResearchTaxonomy = serde_json::from_str(text)?;
+    value.validate()?;
+    Ok(value)
+}
+
+/// Configuration loading error.
+#[derive(Debug, thiserror::Error)]
+pub enum ConfigError {
+    /// File operation failed.
+    #[error(transparent)]
+    Io(#[from] std::io::Error),
+    /// JSON decoding failed.
+    #[error(transparent)]
+    Json(#[from] serde_json::Error),
+    /// Configuration contract failed validation.
+    #[error(transparent)]
+    Model(#[from] model::ModelError),
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn checked_in_configuration_is_valid() {
+        let profile = embedded_profile()
+            .unwrap_or_else(|error| panic!("profile should validate: {error}"));
+        let taxonomy = embedded_taxonomy()
+            .unwrap_or_else(|error| panic!("taxonomy should validate: {error}"));
+        assert_eq!(profile.profile_id, "cairns-and-hinterland-hhs");
+        assert!(taxonomy.themes.len() >= 10);
+    }
+}
