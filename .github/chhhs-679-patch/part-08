+/// Write JSON, CSV, Markdown and HTML from the same structured report payload.
+pub fn write_report_bundle(
+    report: &MonthlyReport,
+    output_root: &Path,
+) -> Result<Vec<std::path::PathBuf>, ReportError> {
+    let directory = output_root.join(&report.month);
+    fs::create_dir_all(&directory)?;
+    let json_path = directory.join("report.json");
+    let csv_path = directory.join("papers.csv");
+    let markdown_path = directory.join("report.md");
+    let html_path = directory.join("index.html");
+    fs::write(&json_path, format!("{}\n", serde_json::to_string_pretty(report)?))?;
+    fs::write(&csv_path, render_csv(report))?;
+    fs::write(&markdown_path, render_markdown(report))?;
+    fs::write(&html_path, render_html(report))?;
+    Ok(vec![json_path, csv_path, markdown_path, html_path])
+}
