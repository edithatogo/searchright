+/// Build one monthly report from the latest run in the requested month, or latest state run.
+pub fn build_monthly_report(
+    state: &MonitorState,
+    month: YearMonth,
+) -> Result<MonthlyReport, ReportError> {
+    state.validate()?;
+    let run = select_run(state, month).ok_or(ReportError::NoRuns)?;
+    let mut attributed_portfolio = state
+        .papers
+        .iter()
+        .filter(|paper| paper.attribution.level.included())
+        .map(report_paper)
+        .collect::<Vec<_>>();
+    attributed_portfolio.sort_by(report_paper_order);
+    let mut new_papers = state
+        .papers
+        .iter()
+        .filter(|paper| {
+            paper.attribution.level.included() && month.contains(&paper.first_seen)
+        })
+        .map(report_paper)
+        .collect::<Vec<_>>();
+    new_papers.sort_by(report_paper_order);
+    let updated_ids = run
+        .changes
+        .iter()
+        .filter(|change| change.kind == RecordChangeKind::Updated)
+        .map(|change| change.record_id.as_str())
+        .collect::<std::collections::BTreeSet<_>>();
+    let mut updated_papers = state
+        .papers
+        .iter()
+        .filter(|paper| updated_ids.contains(paper.canonical_id.as_str()))
+        .map(report_paper)
+        .collect::<Vec<_>>();
+    updated_papers.sort_by(report_paper_order);
+    let mut review_queue = state
+        .papers
+        .iter()
+        .filter(|paper| paper.attribution.review_required)
+        .map(report_paper)
+        .collect::<Vec<_>>();
+    review_queue.sort_by(report_paper_order);
+
+    let attributed = state
+        .papers
+        .iter()
+        .filter(|paper| paper.attribution.level.included())
+        .collect::<Vec<_>>();
+    let theme_counts = count_themes(&attributed);
+    let study_type_counts = count_study_types(&attributed);
+    let providers = provider_statuses(run);
+    let excluded_candidates = state
+        .papers
+        .iter()
+        .filter(|paper| paper.attribution.level == AttributionLevel::Excluded)
+        .count();
+    let stale_records = state
+        .papers
+        .iter()
+        .filter(|paper| paper.stale_due_to_provider_failure)
+        .count();
+
+    Ok(MonthlyReport {
+        schema_version: MONTHLY_REPORT_SCHEMA_VERSION.to_owned(),
+        month: month.label(),
+        run_id: run.run_id.clone(),
+        generated_as_of: run.as_of.clone(),
+        metrics: ReportMetrics {
+            current_candidates: state.papers.len(),
+            current_attributed: attributed_portfolio.len(),
+            newly_attributed_this_month: new_papers.len(),
+            review_queue: review_queue.len(),
+            excluded_candidates,
+            stale_records,
+        },
+        providers,
+        theme_counts,
+        study_type_counts,
+        new_papers,
+        updated_papers,
+        attributed_portfolio,
+        review_queue,
+        limitations: vec![
+            "This is a high-recall candidate monitor over free metadata APIs, not proof that every CHHHS publication has been found."
+                .to_owned(),
+            "Confirmed attribution means qualifying metadata named the organisation; it does not establish employment, institutional ownership, funding, endorsement, or study-site status."
+                .to_owned(),
+            "Facility, historical-name and unstructured matches require accountable review before use as an official institutional record."
+                .to_owned(),
+            "Crossref and OpenAlex queries are broad discovery approximations; PubMed and Europe PMC coverage and metadata completeness also vary."
+                .to_owned(),
+            "Rule-based themes and study types are transparent demonstration classifications, not validated research-performance measures."
+                .to_owned(),
+        ],
+    })
+}
