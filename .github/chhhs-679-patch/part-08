+/// Render the current attributed portfolio as UTF-8 CSV.
+#[must_use]
+pub fn render_csv(report: &MonthlyReport) -> String {
+    let mut output = String::from(
+        "canonical_id,title,authors,container,publication_year,publication_date,attribution,attribution_score,primary_theme,study_type,sources,doi,url,first_seen\n",
+    );
+    for paper in &report.attributed_portfolio {
+        let fields = [
+            paper.canonical_id.clone(),
+            paper.title.clone(),
+            paper.authors.join("; "),
+            paper.container_title.clone().unwrap_or_default(),
+            paper.publication_year.map_or_else(String::new, |value| value.to_string()),
+            paper.publication_date.clone().unwrap_or_default(),
+            format!("{:?}", paper.attribution).to_ascii_lowercase(),
+            paper.attribution_score.to_string(),
+            paper.primary_theme.clone().unwrap_or_default(),
+            paper.study_type.clone(),
+            paper.sources.join("; "),
+            paper.doi.clone().unwrap_or_default(),
+            paper.url.clone().unwrap_or_default(),
+            paper.first_seen.clone(),
+        ];
+        output.push_str(
+            &fields
+                .iter()
+                .map(|field| csv_escape(field))
+                .collect::<Vec<_>>()
+                .join(","),
+        );
+        output.push('\n');
+    }
+    output
+}
