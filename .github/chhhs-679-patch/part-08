+fn report_paper(paper: &MonitoredPaper) -> ReportPaper {
+    ReportPaper {
+        canonical_id: paper.canonical_id.clone(),
+        title: paper.record.title.clone(),
+        authors: paper.record.authors.clone(),
+        container_title: paper.record.container_title.clone(),
+        publication_year: paper.record.publication_year,
+        publication_date: paper.record.publication_date.clone(),
+        attribution: paper.attribution.level,
+        attribution_score: paper.attribution.score,
+        primary_theme: paper
+            .classification
+            .themes
+            .first()
+            .map(|theme| theme.label.clone()),
+        study_type: paper.classification.study_type.label.clone(),
+        sources: paper.source_providers.clone(),
+        doi: paper.record.identifiers.doi.clone(),
+        url: safe_url(&paper.record.urls),
+        first_seen: paper.first_seen.clone(),
+    }
+}
+
+fn safe_url(urls: &[String]) -> Option<String> {
+    urls.iter()
+        .find(|url| url.starts_with("https://") || url.starts_with("http://"))
+        .cloned()
+}
+
+fn report_paper_order(left: &ReportPaper, right: &ReportPaper) -> std::cmp::Ordering {
+    right
+        .publication_date
+        .cmp(&left.publication_date)
+        .then_with(|| right.publication_year.cmp(&left.publication_year))
+        .then_with(|| left.title.cmp(&right.title))
+}
