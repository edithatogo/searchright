[arg(long)]
+        taxonomy: Option<PathBuf>,
+        /// Optional state to validate.
+        #[arg(long)]
+        state: Option<PathBuf>,
+    },
+}
+
+#[tokio::main]
+async fn main() -> Result<()> {
+    let cli = Cli::parse();
+    match cli.command {
+        Command::SeedDemo {
+            state,
+            output,
+            as_of,
+            profile,
+            taxonomy,
+        } => {
+            let as_of = as_of.unwrap_or_else(today_utc);
+            let profile = load_profile(profile.as_deref()).context("load institution profile")?;
+            let taxonomy = load_taxonomy(taxonomy.as_deref()).context("load taxonomy")?;
+            let run_id = format!("fixture-{as_of}");
+            let batch = execute_fixture_search(&profile, &run_id)
+                .await
+                .context("execute Searchright fixture sources")?;
+            let next = process_search_batch(
+                None,
+                &profile,
+                &taxonomy,
+                batch,
+                &run_id,
+                "fixture",
+                &as_of,
+            )
+            .context("process fixture search")?;
+            save_state(&state, &next).context("save monitor state")?;
+            let month = month_from_date(&as_of)?;
+            let report = build_monthly_report(&next, month).context("build monthly report")?;
+            let files = write_report_bundle(&report, &output).context("write report bundle")?;
+            write_summary(&state, &files, &next)?;
+        }
+        Command::Refresh {
+            live,
+            acknowledge_approximate_queries,
+            state,
+            output,
+            as_of,
+            profile,
+            taxonomy,
+            max_records_per_source,
+            max_pages_per_source,
+            page_size,
+            ncbi_email,
+            crossref_mailto,
+            openalex_mailto,
+        } => {
+            if !live {
+                bail!("live refresh is denied unless --live is supplied");
+            }
+            let as_of = as_of.unwrap_or_else(today_utc);
+            let profile = load_profile(profile.as_deref()).context("load institution profile")?;
+            let taxonomy = load_taxonomy(taxonomy.as_deref()).context("load taxonomy")?;
+            let previous = load_state(&state).context("load prior monitor state")?;
+            let run_id = format!(
+                "update-{as_of}-{}",
+                OffsetDateTime::now_utc().unix_timestamp()
+            );
+            let options = SearchOptions {
+                max_records_per_source,
+                max_pages_per_source,
+                page_size,
+                acknowledge_approximate_queries,
+                ncbi_email,
+                crossref_mailto,
+                openalex_mailto,
+                ..SearchOptions::default()
+            };
+            let batch = execute_live_search(&profile, &run_id, &options)
+                .await
+                .context("execute opt-in Searchright live sources")?;
+            let next = process_search_batch(
+                previous.as_ref(),
+                &profile,
+                &taxonomy,
+                batch,
+                &run_id,
+                "update",
+                &as_of,
+            )
+            .context("process live update")?;
+            save_state(&state, &next).context("save monitor state")?;
+            let report = build_monthly_report(&next, month_from_date(&as_of)?)
+                .context("build monthly report")?;
+            let files = write_report_bundle(&report, &output).context("write report bundle")?;
+            write_summary(&state, &files, &next)?;
+        }
+        Command::Report {
+            state,
+            month,
+            output,
+        } => {
+            let value = load_state(&state)
+                .context("load monitor state")?
+                .context("monitor state file does not exist")?;
+            let report = build_monthly_report(&value, YearMonth::parse(&month)?)
+                .context("build monthly report")?;
+            let files = write_report_bundle(&report, &output).context("write report bundle")?;
+            write_summary(&state, &files, &value)?;
+        }
+        Command::Validate {
+            profile,
+            taxonomy,
+            state,
+        } => {
+            load_profile(profile.as_deref()).context("validate institution profile")?;
+            load_taxonomy(taxonomy.as_deref()).context("validate taxonomy")?;
+            if let Some(path) = state {
+                load_state(&path)
+                    .context("validate monitor state")?
+                    .context("monitor state file does not exist")?;
+            }
+            write_stdout("CHHHS demonstration configuration is valid.\n")?;
+        }
+    }
+    Ok(())
+}
+
+fn today_utc() -> String {
+    OffsetDateTime::now_utc().date().to_string()
+}
+
+fn month_from_date(date: &str) -> Result<YearMonth> {
+    let month = date
+        .get(..7)
+        .context("monitor date must use YYYY-MM-DD form")?;
+    Ok(YearMonth::parse(month)?)
+}
+
+fn write_summary(
+    state_path: &std::path::Path,
+    files: &[PathBuf],
+    state: &searchright_chhhs_demo::model::MonitorState,
+) -> Result<()> {
+    let latest = state.runs.last().context("state has no latest run")?;
+    let mut text = format!(
+        "run={} candidates={} attributed={} review={} excluded={} state={}\n",
+        latest.run_id,
+        latest.candidate_count,
+        latest.attributed_count,
+        latest.review_count,
+        latest.excluded_count,
+        state_path.display(),
+    );
+    for file in files {
+        text.push_str(&format!("report={}\n", file.display()));
+    }
+    write_stdout(&text)
+}
+
+fn write_stdout(value: &str) -> Result<()> {
+    let mut output = std::io::stdout().lock();
+    output.write_all(value.as_bytes())?;
+    output.flush()?;
+    Ok(())
+}
