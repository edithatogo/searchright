+/// The role played by one institution name in the governed identity profile.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum AliasKind {
+    /// Exact legal or canonical organisation name.
+    Canonical,
+    /// Current accepted alternative name.
+    Current,
+    /// Current acronym that must match as a complete token.
+    Acronym,
+    /// Facility name that is evidence for, but not identical to, the HHS.
+    Facility,
+    /// Historical name that requires date-aware review.
+    Historical,
+}
+
+/// One governed institution alias.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct InstitutionAlias {
+    /// Stable alias identifier.
+    pub alias_id: String,
+    /// Exact source text to match after deterministic normalisation.
+    pub text: String,
+    /// Alias role.
+    pub kind: AliasKind,
+    /// First applicable publication year, when known.
+    pub valid_from_year: Option<i32>,
+    /// Last applicable publication year, when known.
+    pub valid_to_year: Option<i32>,
+}
+
+impl InstitutionAlias {
+    /// Whether the alias can apply to a publication year.
+    #[must_use]
+    pub fn applies_to_year(&self, year: Option<i32>) -> bool {
+        let Some(year) = year else {
+            return true;
+        };
+        self.valid_from_year.is_none_or(|from| year >= from)
+            && self.valid_to_year.is_none_or(|to| year <= to)
+    }
+}
