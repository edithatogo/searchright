+/// Versioned institution identity used for candidate attribution.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct InstitutionProfile {
+    /// Contract identifier.
+    pub schema_version: String,
+    /// Stable profile identifier.
+    pub profile_id: String,
+    /// Immutable profile version.
+    pub version: String,
+    /// Canonical organisation name.
+    pub canonical_name: String,
+    /// Governed aliases.
+    pub aliases: Vec<InstitutionAlias>,
+    /// Verified durable identifiers, namespaced by scheme such as `ror`.
+    #[serde(default)]
+    pub durable_identifiers: BTreeMap<String, String>,
+    /// Human-readable governance status.
+    pub governance_status: String,
+    /// Scope and limitation notes.
+    #[serde(default)]
+    pub notes: Vec<String>,
+}
+
+impl InstitutionProfile {
+    /// Validate local profile invariants.
+    pub fn validate(&self) -> Result<(), ModelError> {
+        require_text(&self.schema_version, "institution_profile.schema_version")?;
+        if self.schema_version != INSTITUTION_PROFILE_SCHEMA_VERSION {
+            return Err(ModelError::InvalidSchemaVersion {
+                expected: INSTITUTION_PROFILE_SCHEMA_VERSION,
+                actual: self.schema_version.clone(),
+            });
+        }
+        require_text(&self.profile_id, "institution_profile.profile_id")?;
+        require_text(&self.version, "institution_profile.version")?;
+        require_text(&self.canonical_name, "institution_profile.canonical_name")?;
+        require_text(
+            &self.governance_status,
+            "institution_profile.governance_status",
+        )?;
+        if self.aliases.is_empty() {
+            return Err(ModelError::EmptyCollection("institution_profile.aliases"));
+        }
+        let mut identifiers = BTreeSet::new();
+        let mut aliases = BTreeSet::new();
+        let mut canonical = 0_u8;
+        for alias in &self.aliases {
+            require_text(&alias.alias_id, "institution_profile.aliases.alias_id")?;
+            require_text(&alias.text, "institution_profile.aliases.text")?;
+            if !identifiers.insert(alias.alias_id.as_str()) {
+                return Err(ModelError::DuplicateValue(
+                    "institution_profile.aliases.alias_id",
+                ));
+            }
+            let normalised = normalise_text(&alias.text);
+            if !aliases.insert(normalised) {
+                return Err(ModelError::DuplicateValue(
+                    "institution_profile.aliases.text",
+                ));
+            }
+            if alias.kind == AliasKind::Canonical {
+                canonical = canonical.saturating_add(1);
+            }
+            if let (Some(from), Some(to)) = (alias.valid_from_year, alias.valid_to_year)
+                && from > to
+            {
+                return Err(ModelError::InvalidYearRange(alias.alias_id.clone()));
+            }
+        }
+        if canonical != 1 {
+            return Err(ModelError::CanonicalAliasCount(canonical));
+        }
+        for (scheme, identifier) in &self.durable_identifiers {
+            require_text(scheme, "institution_profile.durable_identifiers.scheme")?;
+            require_text(
+                identifier,
+                "institution_profile.durable_identifiers.identifier",
+            )?;
+        }
+        Ok(())
+    }
+}
