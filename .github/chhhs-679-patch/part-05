+pub struct ResearchTaxonomy {
+    /// Contract identifier.
+    pub schema_version: String,
+    /// Immutable taxonomy version.
+    pub version: String,
+    /// Multi-label research themes.
+    pub themes: Vec<CategoryRule>,
+    /// Mutually ranked study-design rules.
+    pub study_types: Vec<CategoryRule>,
+    /// Fallback study type when no rule matches.
+    pub fallback_study_type_id: String,
+}
+
+impl ResearchTaxonomy {
+    /// Validate category identifiers, labels and terms.
+    pub fn validate(&self) -> Result<(), ModelError> {
+        if self.schema_version != TAXONOMY_SCHEMA_VERSION {
+            return Err(ModelError::InvalidSchemaVersion {
+                expected: TAXONOMY_SCHEMA_VERSION,
+                actual: self.schema_version.clone(),
+            });
+        }
+        require_text(&self.version, "research_taxonomy.version")?;
+        require_text(
+            &self.fallback_study_type_id,
+            "research_taxonomy.fallback_study_type_id",
+        )?;
+        if self.themes.is_empty() || self.study_types.is_empty() {
+            return Err(ModelError::EmptyCollection(
+                "research_taxonomy.categories",
+            ));
+        }
+        let mut identifiers = BTreeSet::new();
+        for rule in self.themes.iter().chain(&self.study_types) {
+            require_text(&rule.category_id, "research_taxonomy.category_id")?;
+            require_text(&rule.label, "research_taxonomy.label")?;
+            if rule.terms.is_empty() {
+                return Err(ModelError::EmptyCollection("research_taxonomy.terms"));
+            }
+            if !identifiers.insert(rule.category_id.as_str()) {
+                return Err(ModelError::DuplicateValue(
+                    "research_taxonomy.category_id",
+                ));
+            }
+            let mut terms = BTreeSet::new();
+            for term in &rule.terms {
+                require_text(term, "research_taxonomy.term")?;
+                if !terms.insert(normalise_text(term)) {
+                    return Err(ModelError::DuplicateValue("research_taxonomy.term"));
+                }
+            }
+        }
+        if !self
+            .study_types
+            .iter()
+            .any(|rule| rule.category_id == self.fallback_study_type_id)
+        {
+            return Err(ModelError::UnknownFallbackStudyType(
+                self.fallback_study_type_id.clone(),
+            ));
+        }
+        Ok(())
+    }
+}
