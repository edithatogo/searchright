+//! Deterministic cross-source deduplication, enrichment, lineage and state construction.
+
+use std::collections::{BTreeMap, BTreeSet};
+
+use searchright::{
+    contracts::{BibliographicRecord, RecordIdentifiers},
+    dedup::{DedupConfig, DedupError, Deduplicator, normalise_doi},
+    living::{LivingError, diff_records},
+};
+use serde_json::Value;
+use time::{Date, macros::format_description};
+
+use crate::{
+    attribution::assess_attribution,
+    classification::classify_record,
+    model::{
+        AttributionLevel, InstitutionProfile, MONITOR_STATE_SCHEMA_VERSION, ModelError,
+        MonitorRun, MonitorState, MonitoredPaper, ResearchTaxonomy, SourcedRecord,
+    },
+    search::SearchBatch,
+};
+
+const MAX_RUN_HISTORY: usize = 24;
+
+/// Convert one Searchright execution batch into validated durable monitor state.
+pub fn process_search_batch(
+    previous: Option<&MonitorState>,
+    profile: &InstitutionProfile,
+    taxonomy: &ResearchTaxonomy,
+    mut batch: SearchBatch,
+    run_id: &str,
+    purpose: &str,
+    as_of: &str,
+) -> Result<MonitorState, PipelineError> {
+    profile.validate()?;
+    taxonomy.validate()?;
+    require_text(run_id, "run_id")?;
+    require_text(purpose, "purpose")?;
+    validate_iso_date(as_of)?;
+    if let Some(state) = previous {
+        state.validate()?;
+        if state.runs.iter().any(|run| run.run_id == run_id) {
+            return Err(PipelineError::DuplicateRun(run_id.to_owned()));
+        }
+    }
+
+    carry_records_from_failed_sources(previous, &mut batch);
+    normalise_source_record_ids(&mut batch.records)?;
+    let groups = deduplicate_groups(&batch.records)?;
+    let previous_by_id = previous
+        .map(|state| {
+            state
+                .papers
+                .iter()
+                .map(|paper| (paper.canonical_id.as_str(), paper))
+                .collect::<BTreeMap<_, _>>()
+        })
+        .unwrap_or_default();
+
+    let mut papers = Vec::new();
+    let mut canonical_ids = BTreeSet::new();
+    for group in groups {
+        let mut merged = merge_records(&group)?;
+        let canonical_id = canonical_id(&merged);
+        if !canonical_ids.insert(canonical_id.clone()) {
+            return Err(PipelineError::DuplicateCanonicalId(canonical_id));
+        }
+        merged.record_id.clone_from(&canonical_id);
+        let source_providers = unique_sorted(group.iter().map(|item| item.provider_id.clone()));
+        let source_record_ids = unique_sorted(
+            group
+                .iter()
+                .map(|item| item.record.record_id.clone()),
+        );
+        let attribution = assess_attribution(profile, &group);
+        let classification = classify_record(taxonomy, &merged);
+        let previous_paper = previous_by_id.get(canonical_id.as_str()).copied();
+        let first_seen = previous_paper.map_or_else(
+            || as_of.to_owned(),
+            |paper| paper.first_seen.clone(),
+        );
+        let stale_due_to_provider_failure = group.iter().all(|item| item.carried_forward);
+        let last_seen = if stale_due_to_provider_failure {
+            previous_paper.map_or_else(|| as_of.to_owned(), |paper| paper.last_seen.clone())
+        } else {
+            as_of.to_owned()
+        };
+        papers.push(MonitoredPaper {
+            canonical_id,
+            record: merged,
+            source_providers,
+            source_record_ids,
+            attribution,
+            classification,
+            first_seen,
+            last_seen,
+            stale_due_to_provider_failure,
+        });
+    }
+    papers.sort_by(paper_order);
+
+    let previous_records = previous.map_or_else(Vec::new, |state| {
+        state
+            .papers
+            .iter()
+            .map(|paper| record_for_diff(&paper.record))
+            .collect()
+    });
+    let current_records = papers
+        .iter()
+        .map(|paper| record_for_diff(&paper.record))
+        .collect::<Vec<_>>();
+    let changes = diff_records(&previous_records, &current_records)?;
+
+    let attributed_count = papers
+        .iter()
+        .filter(|paper| paper.attribution.level.included())
+        .count();
+    let review_count = papers
+        .iter()
+        .filter(|paper| paper.attribution.review_required)
+        .count();
+    let excluded_count = papers
+        .iter()
+        .filter(|paper| paper.attribution.level == AttributionLevel::Excluded)
+        .count();
+    let run = MonitorRun {
+        run_id: run_id.to_owned(),
+        purpose: purpose.to_owned(),
+        as_of: as_of.to_owned(),
+        receipts: batch.receipts,
+        provider_failures: batch.provider_failures,
+        changes,
+        candidate_count: papers.len(),
+        attributed_count,
+        review_count,
+        excluded_count,
+    };
+    let mut runs = previous.map_or_else(Vec::new, |state| state.runs.clone());
+    runs.push(run);
+    if runs.len() > MAX_RUN_HISTORY {
+        runs.drain(..runs.len().saturating_sub(MAX_RUN_HISTORY));
+    }
+    let mut source_records = batch.records;
+    source_records.sort_by(|left, right| left.record.record_id.cmp(&right.record.record_id));
+
+    let state = MonitorState {
+        schema_version: MONITOR_STATE_SCHEMA_VERSION.to_owned(),
+        profile_id: profile.profile_id.clone(),
+        profile_version: profile.version.clone(),
+        taxonomy_version: taxonomy.version.clone(),
+        source_records,
+        papers,
+        runs,
+    };
+    state.validate()?;
+    Ok(state)
+}
+
+fn carry_records_from_failed_sources(previous: Option<&MonitorState>, batch: &mut SearchBatch) {
+    let Some(previous) = previous else {
+        return;
+    };
+    let failed = batch
+        .provider_failures
+        .iter()
+        .map(|failure| failure.provider_id.as_str())
+        .collect::<BTreeSet<_>>();
+    if failed.is_empty() {
+        return;
+    }
+    let current_ids = batch
+        .records
+        .iter()
+        .map(|item| item.record.record_id.clone())
+        .collect::<BTreeSet<_>>();
+    batch.records.extend(
+        previous
+            .source_records
+            .iter()
+            .filter(|item| {
+                failed.contains(item.provider_id.as_str())
+                    && !current_ids.contains(&item.record.record_id)
+            })
+            .cloned()
+            .map(|mut item| {
+                item.carried_forward = true;
+                item
+            }),
+    );
+}
+
+fn normalise_source_record_ids(records: &mut [SourcedRecord]) -> Result<(), PipelineError> {
+    let mut seen = BTreeSet::new();
+    for sourced in records {
+        require_text(&sourced.provider_id, "source_record.provider_id")?;
+        require_text(&sourced.record.native_id, "source_record.native_id")?;
+        sourced.record.record_id = format!("{}:{}", sourced.provider_id, sourced.record.native_id);
+        if !seen.insert(sourced.record.record_id.clone()) {
+            return Err(PipelineError::DuplicateSourceRecord(
+                sourced.record.record_id.clone(),
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn deduplicate_groups(records: &[SourcedRecord]) -> Result<Vec<Vec<SourcedRecord>>, PipelineError> {
+    let canonical = records
+        .iter()
+        .map(|item| item.record.clone())
+        .collect::<Vec<_>>();
+    let result =