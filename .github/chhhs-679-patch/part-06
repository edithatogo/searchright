tract identifier.
+    pub schema_version: String,
+    /// Taxonomy version applied.
+    pub taxonomy_version: String,
+    /// Ranked multi-label themes.
+    pub themes: Vec<CategoryScore>,
+    /// Highest-ranked study type.
+    pub study_type: CategoryScore,
+    /// Whether no specific study-type rule matched.
+    pub study_type_uncertain: bool,
+}
+
+/// Provider-normalised record with its source identity retained outside provider metadata.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SourcedRecord {
+    /// Searchright provider identifier.
+    pub provider_id: String,
+    /// Canonical Searchright bibliographic record.
+    pub record: BibliographicRecord,
+    /// True when retained from prior state because its provider failed in the current run.
+    pub carried_forward: bool,
+}
+
+/// One deduplicated monitored publication candidate.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct MonitoredPaper {
+    /// Stable cross-source identifier selected by identifier precedence.
+    pub canonical_id: String,
+    /// Best available canonical record; source records remain named separately.
+    pub record: BibliographicRecord,
+    /// Providers contributing records to this candidate.
+    pub source_providers: Vec<String>,
+    /// Provider-specific record identifiers retained for audit.
+    pub source_record_ids: Vec<String>,
+    /// Institution-attribution result.
+    pub attribution: AttributionAssessment,
+    /// Explainable NLP classification.
+    pub classification: PaperClassification,
+    /// First monitor date in ISO calendar form.
+    pub first_seen: String,
+    /// Most recent successful observation date in ISO calendar form.
+    pub last_seen: String,
+    /// True when retained because one of its only sources failed during this refresh.
+    pub stale_due_to_provider_failure: bool,
+}
+
+/// Redacted provider failure retained in the run summary.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct ProviderFailure {
+    /// Provider identifier.
+    pub provider_id: String,
+    /// Stable failure category.
+    pub code: String,
+    /// Redacted diagnostic suitable for operators.
+    pub message: String,
+}
+
+/// Summary of one initial or update run.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct MonitorRun {
+    /// Stable run identifier.
+    pub run_id: String,
+    /// `initial`, `update`, or `fixture`.
+    pub purpose: String,
+    /// Monitor date in ISO calendar form.
+    pub as_of: String,
+    /// Searchright source receipts.
+    pub receipts: Vec<SourceReceipt>,
+    /// Partial-source failures.
+    pub provider_failures: Vec<ProviderFailure>,
+    /// Living-update record changes.
+    pub changes: Vec<RecordChange>,
+    /// Candidate count after deduplication.
+    pub candidate_count: usize,
+    /// Confirmed plus probable attributed papers.
+    pub attributed_count: usize,
+    /// Records requiring review.
+    pub review_count: usize,
+    /// Records without qualifying evidence.
+    pub excluded_count: usize,
+}
+
+/// Durable, append-oriented application state.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct MonitorState {
+    /// Contract identifier.
+    pub schema_version: String,
+    /// Institution profile identifier.
+    pub profile_id: String,
+    /// Profile version used for the latest run.
+    pub profile_version: String,
+    /// Taxonomy version used for the latest run.
+    pub taxonomy_version: String,
+    /// Provider-specific canonical records retained separately from deduplicated papers.
+    pub source_records: Vec<SourcedRecord>,
+    /// Latest known deduplicated candidates.
+    pub papers: Vec<MonitoredPaper>,
+    /// Bounded run history in chronological order.
+    pub runs: Vec<MonitorRun>,
+}
+
+impl MonitorState {
+    /// Validate persisted state before read or write.
+    pub fn validate(&self) -> Result<(), ModelError> {
+        if self.schema_version != MONITOR_STATE_SCHEMA_VERSION {
+            return Err(ModelError::InvalidSchemaVersion {
+                expected: MONITOR_STATE_SCHEMA_VERSION,
+                actual: self.schema_version.clone(),
+            });
+        }
+        require_text(&self.profile_id, "monitor_state.profile_id")?;
+        require_text(&self.profile_version, "monitor_state.profile_version")?;
+        require_text(&self.taxonomy_version, "monitor_state.taxonomy_version")?;
+        let mut source_identifiers = BTreeSet::new();
+        for sourced in &self.source_records {
+            require_text(&sourced.provider_id, "monitor_state.source_record.provider_id")?;
+            require_text(&sourced.record.record_id, "monitor_state.source_record.record_id")?;
+            sourced.record.validate().map_err(ModelError::BibliographicRecord)?;
+            if !source_identifiers.insert(sourced.record.record_id.as_str()) {
+                return Err(ModelError::DuplicateValue(
+                    "monitor_state.source_record.record_id",
+                ));
+            }
+        }
+        let mut identifiers = BTreeSet::new();
+        for paper in &self.papers {
+            require_text(&paper.canonical_id, "monitor_state.paper.canonical_id")?;
+            if !identifiers.insert(paper.canonical_id.as_str()) {
+                return Err(ModelError::DuplicateValue(
+                    "monitor_state.paper.canonical_id",
+                ));
+            }
+            paper.record.validate().map_err(ModelError::BibliographicRecord)?;
+            if paper.record.record_id != paper.canonical_id {
+                return Err(ModelError::RecordIdentityMismatch(
+                    paper.canonical_id.clone(),
+                ));
+            }
+        }
+        let mut run_ids = BTreeSet::new();
+        for run in &self.runs {
+            require_text(&run.run_id, "monitor_state.run.run_id")?;
+            if !run_ids.insert(run.run_id.as_str()) {
+                return Err(ModelError::DuplicateValue("monitor_state.run.run_id"));
+            }
+        }
+        Ok(())
+    }
+}
+
+/// Deterministic text normalisation shared by profile validation and matching.
+#[must_use]
+pub fn normalise_text(value: &str) -> String {
+    value
+        .chars()
+        .map(|character| {
+            if character.is_alphanumeric() {
+                character.to_ascii_lowercase()
+            } else {
+                ' '
+            }
+        })
+        .collect::<String>()
+        .split_whitespace()
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
+fn require_text(value: &str, field: &'static str) -> Result<(), ModelError> {
+    if value.trim().is_empty() {
+        Err(ModelError::EmptyText(field))
+    } else {
+        Ok(())
+    }
+}
+
+/// Application-contract validation error.
+#[derive(Debug, thiserror::Error)]
+pub enum ModelError {
+    /// Required text was blank.
+    #[error("required field `{0}` is empty")]
+    EmptyText(&'static str),
+    /// Required collection was empty.
+    #[error("required collection `{0}` is empty")]
+    EmptyCollection(&'static str),
+    /// A unique value was duplicated.
+    #[error("value in `{0}` is duplicated")]
+    DuplicateValue(&'static str),
+    /// Wire schema version differed from the expected application contract.
+    #[error("schema version must be `{expected}`, found `{actual}`")]
+    InvalidSchemaVersion {
+        /// Expected schema identifier.
+        expected: &'static str,
+        /// Actual schema identifier.
+        actual: String,
+    },
+    /// Alias validity range was inverted.
+    #[error("institution alias `{0}` has an inverted year range")]
+    InvalidYearRange(String),
+    /// Exactly one canonical alias is required.
+    #[error("institution profile requires exactly one canonical alias, found {0}")]
+    CanonicalAliasCount(u8),
+    /// Taxonomy fallback did not name a study-type rule.
+    #[error("fallback study type `{0}` is not declared")]
+    UnknownFallbackStudyType(String),
+    /// Canonical Searchright record failed its own contract validation.
+    #[error("bibliographic record is invalid: {0}")]
+    BibliographicRecord(searchright::contracts::ContractError),
+    /// Persisted record and paper identifiers diverged.
+    #[error("paper `{0}` does not own the same canonical record identifier")]
+    RecordIdentityMismatch(String),
+}
+
