+/// Calendar month used by the report interface.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+pub struct YearMonth {
+    year: i32,
+    month: u8,
+}
+
+impl YearMonth {
+    /// Parse `YYYY-MM`.
+    pub fn parse(value: &str) -> Result<Self, ReportError> {
+        let (year, month) = value
+            .split_once('-')
+            .ok_or_else(|| ReportError::InvalidMonth(value.to_owned()))?;
+        let year = year
+            .parse::<i32>()
+            .map_err(|_| ReportError::InvalidMonth(value.to_owned()))?;
+        let month = month
+            .parse::<u8>()
+            .map_err(|_| ReportError::InvalidMonth(value.to_owned()))?;
+        if !(1..=12).contains(&month) || year < 1 {
+            return Err(ReportError::InvalidMonth(value.to_owned()));
+        }
+        Ok(Self { year, month })
+    }
+
+    /// Render `YYYY-MM`.
+    #[must_use]
+    pub fn label(self) -> String {
+        format!("{:04}-{:02}", self.year, self.month)
+    }
+
+    fn contains(self, date: &str) -> bool {
+        date.starts_with(&self.label())
+    }
+}
