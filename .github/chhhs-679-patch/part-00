+name: CHHHS research intelligence demonstration
+
+on:
+  workflow_dispatch:
+  schedule:
+    - cron: "17 20 * * 0"
+
+permissions:
+  contents: read
+
+concurrency:
+  group: chhhs-research-intelligence
+  cancel-in-progress: false
+
+jobs:
+  refresh:
+    name: Refresh free metadata sources and render monthly report
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+    steps:
+      - name: Checkout
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - name: Install repository-pinned Rust toolchain
+        run: rustup toolchain install 1.97.1 --profile minimal
+      - name: Restore non-authoritative monitor state
+        uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
+        with:
+          path: .searchright/chhhs/state.json
+          key: chhhs-monitor-${{ runner.os }}-${{ github.run_id }}
+          restore-keys: |
+            chhhs-monitor-${{ runner.os }}-
+      - name: Run explicit live refresh
+        env:
+          NCBI_EMAIL: ${{ vars.NCBI_EMAIL }}
+          CROSSREF_MAILTO: ${{ vars.CROSSREF_MAILTO }}
+          OPENALEX_MAILTO: ${{ vars.OPENALEX_MAILTO }}
+        run: >-
+          cargo run --locked -p searchright-chhhs-demo --features live -- refresh
+          --live
+          --acknowledge-approximate-queries
+          --as-of "$(date -u +%F)"
+          --state .searchright/chhhs/state.json
+          --output reports/chhhs-research-intelligence
+      - name: Save non-authoritative monitor state
+        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
+        with:
+          path: .searchright/chhhs/state.json
+          key: chhhs-monitor-${{ runner.os }}-${{ github.run_id }}
+      - name: Preserve report and state as a review artifact
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+        with:
+          name: chhhs-research-intelligence-${{ github.run_id }}
+          path: |
+            reports/chhhs-research-intelligence/
+            .searchright/chhhs/state.json
+          if-no-files-found: error
+          retention-days: 30
