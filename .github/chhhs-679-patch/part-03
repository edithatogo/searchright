--- /dev/null
+++ b/crates/searchright-chhhs-demo/src/attribution.rs
@@ -0,0 +1,403 @@
+//! Conservative, explainable institution-attribution rules.
+
+use std::collections::BTreeSet;
+
+use serde_json::Value;
+
+use crate::model::{
+    ATTRIBUTION_SCHEMA_VERSION, AliasKind, AttributionAssessment, AttributionEvidence,
+    AttributionField, AttributionLevel, InstitutionAlias, InstitutionProfile, SourcedRecord,
+    normalise_text,
+};
+
+const CONFIRMED_THRESHOLD: u8 = 90;
+const PROBABLE_THRESHOLD: u8 = 70;
+const REVIEW_THRESHOLD: u8 = 30;
+
+/// Assess a cross-source record group against one governed institution profile.
+#[must_use]
+pub fn assess_attribution(
+    profile: &InstitutionProfile,
+    records: &[SourcedRecord],
+) -> AttributionAssessment {
+    let mut evidence = Vec::new();
+    for sourced in records {
+        collect_durable_identifier_evidence(profile, sourced, &mut evidence);
+        collect_structured_evidence(profile, sourced, &mut evidence);
+        collect_unstructured_evidence(profile, sourced, &mut evidence);
+    }
+    evidence.sort_by(|left, right| {
+        right
+            .score
+            .cmp(&left.score)
+            .then_with(|| left.rule_id.cmp(&right.rule_id))
+            .then_with(|| left.matched_value.cmp(&right.matched_value))
+            .then_with(|| left.source_path.cmp(&right.source_path))
+    });
+    evidence.dedup_by(|left, right| {
+        left.rule_id == right.rule_id
+            && left.matched_value == right.matched_value
+            && left.field == right.field
+            && left.source_path == right.source_path
+    });
+
+    let score = evidence.first().map_or(0, |item| item.score);
+    let level = match score {
+        CONFIRMED_THRESHOLD..=u8::MAX => AttributionLevel::Confirmed,
+        PROBABLE_THRESHOLD..=89 => AttributionLevel::Probable,
+        REVIEW_THRESHOLD..=69 => AttributionLevel::Review,
+        _ => AttributionLevel::Excluded,
+    };
+    let review_required = matches!(level, AttributionLevel::Probable | AttributionLevel::Review);
+    let limitations = match level {
+        AttributionLevel::Confirmed => vec![
+            "Confirmation reflects metadata attribution, not authorship employment, study-site ownership, funding, or institutional endorsement."
+                .to_owned(),
+        ],
+        AttributionLevel::Probable => vec![
+            "Facility or historical-name evidence requires accountable validation against the governed CHHHS identity register."
+                .to_owned(),
+        ],
+        AttributionLevel::Review => vec![
+            "The institution was mentioned outside a qualifying structured affiliation field; no automatic attribution was made."
+                .to_owned(),
+        ],
+        AttributionLevel::Excluded => vec![
+            "No qualifying structured institutional evidence was found. A geographic mention of Cairns alone is never sufficient."
+                .to_owned(),
+        ],
+    };
+
+    AttributionAssessment {
+        schema_version: ATTRIBUTION_SCHEMA_VERSION.to_owned(),
+        profile_version: profile.version.clone(),
+        level,
+        score,
+        review_required,
+        evidence,
+        limitations,
+    }
+}
+
+fn collect_durable_identifier_evidence(
+    profile: &InstitutionProfile,
+    sourced: &SourcedRecord,
+    output: &mut Vec<AttributionEvidence>,
+) {
+    if profile.durable_identifiers.is_empty() {
+        return;
+    }
+    let strings = structured_strings(&sourced.record.provider_metadata);
+    for (scheme, identifier) in &profile.durable_identifiers {
+        let expected = normalise_identifier(identifier);
+        for item in &strings {
+            if normalise_identifier(&item.value) == expected {
+                output.push(AttributionEvidence {
+                    rule_id: format!("durable_identifier.{scheme}"),
+                    matched_value: identifier.clone(),
+                    field: AttributionField::DurableIdentifier,
+                    source_path: Some(format!("{}:{}", sourced.provider_id, item.path)),
+                    score: 100,
+                    explanation: format!(
+                        "The provider metadata contains the governed {scheme} identifier."
+                    ),
+                });
+            }
+        }
+    }
+}
+
+fn collect_structured_evidence(
+    profile: &InstitutionProfile,
+    sourced: &SourcedRecord,
+    output: &mut Vec<AttributionEvidence>,
+) {
+    for item in structured_strings(&sourced.record.provider_metadata) {
+        for alias in &profile.aliases {
+            if !alias.applies_to_year(sourced.record.publication_year)
+                || !alias_matches(alias, &item.value)
+            {
+                continue;
+            }
+            let (rule_id, score, explanation) = structured_rule(alias);
+            output.push(AttributionEvidence {
+                rule_id: rule_id.to_owned(),
+                matched_value: alias.text.clone(),
+                field: AttributionField::StructuredAffiliation,
+                source_path: Some(format!("{}:{}", sourced.provider_id, item.path)),
+                score,
+                explanation: explanation.to_owned(),
+            });
+        }
+    }
+}
+
+fn collect_unstructured_evidence(
+    profile: &InstitutionProfile,
+    sourced: &SourcedRecord,
+    output: &mut Vec<AttributionEvidence>,
+) {
+    let record = &sourced.record;
+    let mut fields = vec![(AttributionField::Title, record.title.as_str())];
+    if let Some(abstract_text) = record.abstract_text.as_deref() {
+        fields.push((AttributionField::Abstract, abstract_text));
+    }
+    for subject in &record.subjects {
+        fields.push((AttributionField::Subject, subject));
+    }
+    for (field, value) in fields {
+        for alias in &profile.aliases {
+            if !alias.applies_to_year(record.publication_year) || !alias_matches(alias, value) {
+                continue;
+            }
+            let score = match alias.kind {
+                AliasKind::Canonical | AliasKind::Current | AliasKind::Acronym => 45,
+                AliasKind::Facility | AliasKind::Historical => 35,
+            };
+            output.push(AttributionEvidence {
+                rule_id: "unstructured_institution_mention".to_owned(),
+                matched_value: alias.text.clone(),
+                field: field.clone(),
+                source_path: Some(sourced.provider_id.clone()),
+                score,
+                explanation: "The name occurs in descriptive metadata, which creates a review candidate but does not establish affiliation."
+                    .to_owned(),
+            });
+        }
+    }
+}
+
+fn structured_rule(alias: &InstitutionAlias) -> (&'static str, u8, &'static str) {
+    match alias.kind {
+        AliasKind::Canonical => (
+            "structured_canonical_affiliation",
+            98,
+            "A structured affiliation field contains the governed canonical organisation name.",
+        ),
+        AliasKind::Current => (
+            "structured_current_alias",
+            94,
+            "A structured affiliation field contains a governed current organisation alias.",
+        ),
+        AliasKind::Acronym => (
+            "structured_current_acronym",
+            92,
+            "A structured affiliation field contains the governed organisation acronym as a complete token.",
+        ),
+        AliasKind::Facility => (
+            "structured_facility_affiliation",
+            80,
+            "A structured affiliation field names a governed CHHHS facility; parent-organisation attribution remains reviewable.",
+        ),
+        AliasKind::Historical => (
+            "structured_historical_affiliation",
+            76,
+            "A structured affiliation field contains a historical name within its declared validity range.",
+        ),
+    }
+}
+
+fn alias_matches(alias: &InstitutionAlias, value: &str) -> bool {
+    let alias_text = normalise_text(&alias.text);
+    let candidate = normalise_text(value);
+    if alias.kind == AliasKind::Acronym {
+        candidate.split_whitespace().any(|token| token == alias_text)
+    } else {
+        contains_phrase(&candidate, &alias_text)
+    }
+}
+
+fn contains_phrase(haystack: &str, needle: &str) -> bool {
+    if needle.is_empty() {
+        return false;
+    }
+    let padded_haystack = format!(" {haystack} ");
+    let padded_needle = format!(" {needle} ");
+    padded_haystack.contains(&padded_needle)
+}
+
+fn normalise_identifier(value: &str) -> String {
+    value
+        .trim()
+        .trim_end_matches('/')
+        .to_ascii_lowercase()
+        .trim_start_matches("https://ror.org/")
+        .to_owned()
+}
+
+#[derive(Debug, Clone)]
+struct StructuredString {
+    path: String,
+    value: String,
+}
+
+fn structured_strings(value: &Value) -> Vec<StructuredString> {
+    let mut output = Vec::new();
+    visit_value(value, "$", false, &mut output);
+    output
+}
+
+fn visit_value(
+    value: &Value,
+    path: &str,
+    structured_context: bool,
+    output: &mut Vec<StructuredString>,
+) {
+    match value {
+        Value::Object(object) => {
+            for (key, child) in object {
+                let lower = key.to_ascii_lowercase();
+                let structured = structured_context || is_structured_key(&lower);
+                visit_value(child, &format!("{path}.{key}"), structured, output);
+            }
+        }
+        Value::Array(items) => {
+            for (index, child) in items.iter().enumerate() {
+                visit_value(child, &format!("{path}[{index}]"), structured_context, output);
+            }
+        }
+        Value::String(text) if structured_context && !text.trim().is_empty() => {
+            output.push(StructuredString {
+                path: path.to_owned(),
+                value: text.clone(),
+            });
+        }
+        _ => {}
+    }
+}
+
+fn is_structured_key(key: &str) -> bool {
+    [
+        "affiliat",
+        "institution",
+        "organisation",
+        "organization",
+        "ror",
+    ]
+    .iter()
+    .any(|marker| key.contains(marker))
+}
+
