+/// Execute the checked-in rights-clear fixture corpus through Searchright's provider runtime.
+pub async fn execute_fixture_search(
+    profile: &InstitutionProfile,
+    run_id: &str,
+) -> Result<SearchBatch, SearchError> {
+    profile.validate()?;
+    let specs = provider_search_specs(profile);
+    let pages = fixture_pages()?;
+    let mut registry = ProviderRegistry::new();
+    for spec in &specs {
+        let page = pages
+            .get(spec.provider_id)
+            .cloned()
+            .ok_or(SearchError::MissingFixture(spec.provider_id))?;
+        registry.register(Arc::new(FixtureProvider::one_page(
+            spec.provider_id,
+            spec.source_label,
+            page.records,
+        )))?;
+    }
+    execute_specs(&registry, &specs, run_id, false, &SearchOptions::default()).await
+}
