+
+async fn execute_specs(
+    registry: &ProviderRegistry,
+    specs: &[ProviderSearchSpec],
+    run_id: &str,
+    live: bool,
+    options: &SearchOptions,
+) -> Result<SearchBatch, SearchError> {
+    let mut records = Vec::new();
+    let mut receipts = Vec::new();
+    let mut provider_failures = Vec::new();
+    for spec in specs {
+        let request = SearchRequest {
+            review_id: "chhhs-publication-monitor".to_owned(),
+            run_id: run_id.to_owned(),
+            strategy: spec.strategy.clone(),
+            cursor: None,
+            page_size: options.page_size,
+            policy: ExecutionPolicy {
+                live_enabled: live,
+                max_records: options.max_records_per_source,
+                max_pages: options.max_pages_per_source,
+                timeout_seconds: options.timeout_seconds,
+                total_timeout_seconds: Some(options.total_timeout_seconds),
+                max_retries: 2,
+                min_interval_ms: 0,
+                retry_base_delay_ms: Some(500),
+                retry_max_delay_ms: Some(30_000),
+                max_response_bytes: Some(16 * 1024 * 1024),
+                replay_enabled: false,
+                cache_write_enabled: false,
+            },
+        };
+        match registry
+            .execute(spec.provider_id, request, spec.source_label)
+            .await
+        {
+            Ok(result) => {
+                records.extend(result.records.into_iter().map(|mut record| {
+                    record.record_id = format!("{}:{}", spec.provider_id, record.native_id);
+                    SourcedRecord {
+                        provider_id: spec.provider_id.to_owned(),
+                        record,
+                        carried_forward: false,
+                    }
+                }));
+                receipts.push(result.receipt);
+            }
+            Err(error) => provider_failures.push(provider_failure(spec.provider_id, &error)),
+        }
+    }
+    if receipts.is_empty() {
+        return Err(SearchError::AllProvidersFailed(provider_failures));
+    }
+    Ok(SearchBatch {
+        records,
+        receipts,
+        provider_failures,
+    })
+}
+
+fn provider_failure(provider_id: &str, error: &ProviderError) -> ProviderFailure {
+    let code = match error {
+        ProviderError::NotRegistered(_) => "not_registered",
+        ProviderError::AlreadyRegistered(_) => "already_registered",
+        ProviderError::InvalidManifest(_) => "invalid_manifest",
+        ProviderError::InvalidRequest(_) => "invalid_request",
+        ProviderError::LiveDisabled(_) => "live_disabled",
+        ProviderError::ReplayDisabled(_) => "replay_disabled",
+        ProviderError::BudgetExceeded { .. } => "budget_exceeded",
+        ProviderError::InvalidRecord { .. } => "invalid_record",
+        ProviderError::Timeout { .. } => "timeout",
+        ProviderError::RateLimited { .. } => "rate_limited",
+        ProviderError::HttpStatus { .. } => "http_status",
+        ProviderError::MalformedResponse { .. } => "malformed_response",
+        ProviderError::PolicyViolation { .. } => "policy_violation",
+        ProviderError::Cancelled { .. } => "cancelled",
+        ProviderError::Upstream { .. } => "upstream",
+        ProviderError::Cache(_) => "cache",
+        ProviderError::Serialization(_) => "serialization",
+        ProviderError::Timestamp(_) => "timestamp",
+    };
+    ProviderFailure {
+        provider_id: provider_id.to_owned(),
+        code: code.to_owned(),
+        message: error.to_string(),
+    }
+}
