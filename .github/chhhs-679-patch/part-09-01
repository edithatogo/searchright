+/// Execute the four opt-in free API providers. The caller must separately approve live access.
+#[cfg(feature = "live")]
+pub async fn execute_live_search(
+    profile: &InstitutionProfile,
+    run_id: &str,
+    options: &SearchOptions,
+) -> Result<SearchBatch, SearchError> {
+    use searchright::connectors::{LiveProviderConfig, register_mvp_live_providers};
+
+    profile.validate()?;
+    let specs = provider_search_specs(profile);
+    if !options.acknowledge_approximate_queries
+        && specs.iter().any(|item| item.strategy.review_required)
+    {
+        return Err(SearchError::ApproximateQueryReviewRequired);
+    }
+    let mut registry = ProviderRegistry::new();
+    register_mvp_live_providers(
+        &mut registry,
+        LiveProviderConfig {
+            ncbi_tool: options.ncbi_tool.clone(),
+            ncbi_email: options.ncbi_email.clone(),
+            crossref_mailto: options.crossref_mailto.clone(),
+            openalex_mailto: options.openalex_mailto.clone(),
+        },
+    )?;
+    execute_specs(&registry, &specs, run_id, true, options).await
+}
