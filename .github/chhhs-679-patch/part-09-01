+/// Build the four free-API search specifications from the governed profile.
+#[must_use]
+pub fn provider_search_specs(profile: &InstitutionProfile) -> Vec<ProviderSearchSpec> {
+    let aliases = profile
+        .aliases
+        .iter()
+        .map(|alias| alias.text.as_str())
+        .collect::<Vec<_>>();
+    vec![
+        spec(
+            "pubmed",
+            "PubMed via NCBI E-utilities",
+            SearchDialect::PubMed,
+            affiliation_query(&aliases, "[Affiliation]", ""),
+            false,
+            profile,
+        ),
+        spec(
+            "europe-pmc",
+            "Europe PMC",
+            SearchDialect::EuropePmc,
+            affiliation_query(&aliases, "", "AFFILIATION:"),
+            false,
+            profile,
+        ),
+        spec(
+            "crossref",
+            "Crossref Works discovery",
+            SearchDialect::Crossref,
+            broad_query(&aliases),
+            true,
+            profile,
+        ),
+        spec(
+            "openalex",
+            "OpenAlex Works discovery",
+            SearchDialect::OpenAlex,
+            broad_query(&aliases),
+            true,
+            profile,
+        ),
+    ]
+}
